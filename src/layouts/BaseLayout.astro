---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../consts';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  // Startseite setzt SITE.titleHome, das den Namen schon enthält, und
  // schaltet den Zusatz aus. Unterseiten bekommen ihn automatisch.
  titleSuffix?: boolean;
  // Structured Data als JSON-Objekt. Aktuell nutzt das nur die Startseite
  // (WebSite + Organization). Wird als <script type="application/ld+json">
  // in den Head geschrieben.
  jsonLd?: Record<string, unknown>;
}

const { title, description, titleSuffix = true, jsonLd } = Astro.props;
const pageTitle = titleSuffix ? `${title} · ${SITE.name}` : title;

if (!Astro.site) {
  throw new Error(
    'astro.config.mjs: `site` fehlt. Canonical- und Open-Graph-URLs brauchen die Domain.',
  );
}

// Cloudflare Pages liefert dist/predigten/index.html unter /predigten aus und
// leitet /predigten/ per 308 dorthin um. Astro.url.pathname endet bei
// build.format 'directory' aber auf '/'. Ohne diese Zeile zeigt jeder
// Canonical auf eine Weiterleitung statt auf die Seite selbst.
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const canonical = new URL(path, Astro.site).href;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />

    <!-- Open Graph: steuert die Vorschaukarte beim Teilen in WhatsApp,
         Signal, Telegram, Facebook. Für eine Gemeindegründung der
         wichtigste Verbreitungsweg überhaupt. Kein Fremd-Request im
         Browser — die Karte baut der Messenger server-seitig von unserer
         eigenen Domain. -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:title" content={pageTitle} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/og.png', Astro.site).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Arche Bremen — Evangelisch-reformierte Freikirche" />

    <!-- Nur diese eine Zeile: X fällt für Titel, Beschreibung und Bild
         automatisch auf die og:-Angaben oben zurück. Ein zweiter Satz
         twitter:title/description/image wäre reine Verdopplung. -->
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" type="image/png" href="/favicon.png" />
    <!-- Above the fold gebraucht, deshalb vorab geladen statt nur per
         @font-face in global.css referenziert. Beide Schnitte, weil der
         Hero above the fold sowohl den Claim (400) als auch die Headline
         (600) zeigt. -->
    <link
      rel="preload"
      href="/fonts/source-serif-400-v2.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/source-serif-600.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    {jsonLd && <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
