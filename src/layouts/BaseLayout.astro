---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../consts';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  // Startseite setzt SITE.titleHome, das den Namen schon enthält, und
  // schaltet den Zusatz aus. Unterseiten bekommen ihn automatisch.
  titleSuffix?: boolean;
  // Structured Data als JSON-Objekt. Aktuell nutzt das nur die Startseite
  // (WebSite + Organization). Wird als <script type="application/ld+json">
  // in den Head geschrieben.
  jsonLd?: Record<string, unknown>;
}

const { title, description, titleSuffix = true, jsonLd } = Astro.props;
const pageTitle = titleSuffix ? `${title} · ${SITE.name}` : title;

if (!Astro.site) {
  throw new Error(
    'astro.config.mjs: `site` fehlt. Canonical- und Open-Graph-URLs brauchen die Domain.',
  );
}

// Cloudflare Pages liefert dist/predigten/index.html unter /predigten aus und
// leitet /predigten/ per 308 dorthin um. Astro.url.pathname endet bei
// build.format 'directory' aber auf '/'. Ohne diese Zeile zeigt jeder
// Canonical auf eine Weiterleitung statt auf die Seite selbst.
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const canonical = new URL(path, Astro.site).href;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />

    <!-- Open Graph: steuert die Vorschaukarte beim Teilen in WhatsApp,
         Signal, Telegram, Facebook. Für eine Gemeindegründung der
         wichtigste Verbreitungsweg überhaupt. Kein Fremd-Request im
         Browser — die Karte baut der Messenger server-seitig von unserer
         eigenen Domain. -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:title" content={pageTitle} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/og.png', Astro.site).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Arche Bremen — Evangelisch-reformierte Freikirche" />

    <!-- Nur diese eine Zeile: X fällt für Titel, Beschreibung und Bild
         automatisch auf die og:-Angaben oben zurück. Ein zweiter Satz
         twitter:title/description/image wäre reine Verdopplung. -->
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" type="image/png" href="/favicon.png" />
    <!-- Above the fold gebraucht, deshalb vorab geladen statt nur per
         @font-face in global.css referenziert — auf jeder Seite, nicht nur
         der Startseite: Futura 700 trägt seit der Umstellung auf gemischte
         Schreibweise jede Überschrift UND alle Versal-Labels, Source Serif
         400 den Fließtext-Anfang.

         Futura 500 wurde hier bis September 2026 mit vorgeladen und war zu
         dem Zeitpunkt längst unbenutzt — der Schnitt kommt seit der
         Umstellung auf Futura Bold in keiner Regel mehr vor, nur noch im
         @font-face. Das waren rund 11 KB Fehlladung bei jedem Seitenaufruf.
         Die @font-face-Deklaration bleibt stehen: Sie kostet nichts,
         solange kein font-weight: 500 sie anfordert, und hält den Schnitt
         verfügbar. Source Serif 600
         (<strong>/Markdown-Bold) ist dagegen seiten- und
         inhaltsabhängig — kein verlässlicher Above-the-fold-Fall mehr,
         seit die Headlines von Source Serif 600 auf Futura 500 gewechselt
         sind (siehe DESIGN.md, "Futura für Headlines, Source Serif Pro für
         Fließtext") — deshalb hier nicht mehr vorab geladen. -->
    <link
      rel="preload"
      href="/fonts/futura-700.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/source-serif-400-v2.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    {jsonLd && <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />

    <script is:inline>
      // Sheets per Wischgeste schließen. Auf dem Telefon ist das die
      // erwartete Geste — die Griffleiste am Kopf verspricht sie, also
      // muss sie auch funktionieren. Vierte benannte Ausnahme von
      // CLAUDE.md Regel 4 (siehe dort); reines Progressive Enhancement:
      // Ohne JavaScript bleiben Kreuz, Tippen auf den Verdunkler und
      // Escape.
      //
      // Warum touch- und nicht pointer-Ereignisse: Die Gebärde muss dem
      // Browser weggenommen werden, solange gewischt wird, sonst scrollt
      // er stattdessen die Karte. Das geht nur mit preventDefault auf
      // einem nicht-passiven touchmove.
      //
      // Ein Element je Seite, nicht je Popup: Auf /glaubensbekenntnis
      // gibt es 25 davon.
      (function () {
        // ---- Fokusring nach einem Tipp nicht stehen lassen ----------------
        // Beim Schließen setzt der Browser den Fokus auf den Auslöser
        // zurück. Für die Tastatur ist das genau richtig — man steht wieder
        // an der Kachel, von der man kam. Nach einem Tipp oder Klick ist es
        // dagegen nur ein Rechteck, das niemand angefordert hat; iOS Safari
        // zeigt es dort, Chromium nicht (deren Heuristik, wann ein Fokus
        // „sichtbar" ist, unterscheidet sich).
        //
        // Deshalb nicht den Ring abschaffen, sondern den Fall trennen: Wir
        // merken uns, ob zuletzt gezeigt oder getastet wurde, und nehmen den
        // Fokus nur nach einem Zeigerereignis weg. Escape und Tabben bleiben
        // unberührt.
        var pointerLast = false;
        addEventListener('pointerdown', function () { pointerLast = true; }, true);
        addEventListener('keydown', function () { pointerLast = false; }, true);

        document.querySelectorAll('[popover]').forEach(function (popover) {
          popover.addEventListener('toggle', function (event) {
            if (event.newState !== 'closed' || !pointerLast) return;
            var focused = document.activeElement;
            if (focused && focused.blur) focused.blur();
          });
        });

        // ---- Sheets per Wischgeste schließen -----------------------------
        var THRESHOLD = 90; // px, ab hier gilt die Geste als „schließen"
        document.querySelectorAll('[popover][data-swipe]').forEach(function (sheet) {
          var panel = sheet.querySelector('[data-swipe-panel]') || sheet;
          // 1 = nach unten wegwischen, -1 = nach oben
          var dir = sheet.dataset.swipe === 'up' ? -1 : 1;
          var startY = null;
          var travel = 0;

          panel.addEventListener('touchstart', function (event) {
            if (event.touches.length !== 1) return;
            // Erst wischen, wenn der Inhalt am Anfang steht — sonst wäre
            // die Geste dem Scrollen im Popup im Weg.
            var atEdge = dir === 1 ? panel.scrollTop <= 0 : panel.scrollTop >= panel.scrollHeight - panel.clientHeight;
            if (!atEdge) return;
            startY = event.touches[0].clientY;
            travel = 0;
            panel.style.transition = 'none';
          }, { passive: true });

          panel.addEventListener('touchmove', function (event) {
            if (startY === null) return;
            travel = (event.touches[0].clientY - startY) * dir;
            if (travel <= 0) return;
            event.preventDefault();
            panel.style.translate = '0 ' + travel * dir + 'px';
          }, { passive: false });

          function release() {
            if (startY === null) return;
            startY = null;
            panel.style.transition = '';
            panel.style.translate = '';
            if (travel > THRESHOLD) sheet.hidePopover();
          }

          panel.addEventListener('touchend', release);
          panel.addEventListener('touchcancel', release);
        });
      })();
    </script>
  </body>
</html>
