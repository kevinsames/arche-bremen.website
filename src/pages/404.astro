---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Section from '../components/Section.astro';

// Astro schreibt diese Seite nach dist/404.html. Cloudflare Pages liefert
// sie automatisch für jeden unbekannten Pfad aus — keine Konfiguration in
// public/_headers oder einer _redirects-Datei nötig.
//
// noindex: Die Seite soll nicht als Suchergebnis auftauchen. Die fehlende
// Description allein hätte das nicht verhindert — sie bestimmt nur den
// Vorschautext, nicht ob Google die Seite aufnimmt.
---

<BaseLayout title="Seite nicht gefunden" noindex>
  <PageHeader
    eyebrow="404"
    title="Seite nicht gefunden"
    cloud={4}
    lead="Die aufgerufene Seite gibt es nicht oder nicht mehr. Vielleicht hilft einer dieser Wege weiter:"
  />

  <Section tone="light" width="measure">
    <ul>
      <li><a href="/">Startseite</a></li>
      <li><a href="/predigten">Predigten</a></li>
      <li><a href="/gemeindeleitung">Gemeindeleitung</a></li>
      <li><a href="/glaubensbekenntnis">Glaubensbekenntnis</a></li>
    </ul>
  </Section>
</BaseLayout>
