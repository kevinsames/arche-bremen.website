---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/Section.astro';
import ElderCard from '../../components/ElderCard.astro';
import Slider from '../../components/Slider.astro';

const elders = (await getCollection('elders')).sort((a, b) =>
  a.data.name.localeCompare(b.data.name, 'de'),
);
---

<BaseLayout title="Älteste">
  <Section tone="light">
    <h1>Älteste</h1>

    {
      elders.length === 0 ? (
        <p>Noch keine Profile hinterlegt.</p>
      ) : (
        <Slider>
          {elders.map((elder, index) => (
            <ElderCard elder={elder} index={index} />
          ))}
        </Slider>
      )
    }
  </Section>
</BaseLayout>
