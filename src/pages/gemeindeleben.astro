---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import MinistryCard from '../components/MinistryCard.astro';
import Slider from '../components/Slider.astro';

const ministries = (await getCollection('ministries')).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<BaseLayout
  title="Gemeindeleben"
  description="Unsere Vision für das Gemeindeleben der Arche Bremen: Sonntagsgottesdienste, Kinder, Jugend, Hauskreise, Gebetsstunde, Glaubensgrundkurs, Männer und Frauen — geplant für die Zeit nach der Gründung."
>
  <Section tone="light" width="measure">
    <h1>Gemeindeleben</h1>
    <p class="lead">
      Wir stehen noch vor der Gründung — nichts von dem hier läuft heute
      schon. Diese Seite zeigt, was wir für das Leben unserer Gemeinde auf
      dem Herzen haben und was wir in Zukunft Schritt für Schritt aufbauen
      möchten.
    </p>
  </Section>

  <Section tone="muted">
    {
      ministries.length === 0 ? (
        <p>Noch keine Bereiche hinterlegt.</p>
      ) : (
        <Slider label="Gemeindeleben">
          {ministries.map((ministry, index) => (
            <MinistryCard ministry={ministry} index={index} />
          ))}
        </Slider>
      )
    }
    <p class="more-hint">… und noch vieles mehr.</p>
  </Section>
</BaseLayout>

<style>
  .more-hint {
    margin-top: var(--sp-3);
    color: var(--text-secondary);
    font-style: italic;
  }
</style>
