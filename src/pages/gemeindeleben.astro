---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Section from '../components/Section.astro';
import MinistryCard from '../components/MinistryCard.astro';
import Slider from '../components/Slider.astro';

const ministries = (await getCollection('ministries')).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<BaseLayout
  title="Gemeindeleben"
  description="Unsere Vision für das Gemeindeleben der Arche Bremen: Sonntagsgottesdienste, Kinder, Hauskreise, Gebetsstunde, Glaubensgrundkurs, Jugend, Männer und Frauen — geplant für die Zeit nach der Gründung."
>
  {/* Vers zitiert nach Elberfelder Bibel (2006); die Quellenzeile nennt
      bewusst nur „Die Bibel" (DESIGN.md, „Bibelvers auf dunklem Grund"). */}
  <PageHeader
    eyebrow="Gemeinsam Glauben leben"
    title="Gemeindeleben"
    cloud={1}
    lead="Wir stehen noch vor der Gründung — nichts von dem hier läuft heute schon. Diese Seite zeigt, was wir für das Leben unserer Gemeinde auf dem Herzen haben und was wir in Zukunft Schritt für Schritt aufbauen möchten."
    verse={{
      text: 'So, in Liebe zu euch hingezogen, waren wir willig, euch nicht allein am Evangelium Gottes, sondern auch an unserem eigenen Leben Anteil zu geben, weil ihr uns lieb geworden wart.',
      reference: '1. Thessalonicher 2,8',
    }}
  />

  <Section tone="muted">
    {
      ministries.length === 0 ? (
        <p>Noch keine Bereiche hinterlegt.</p>
      ) : (
        <Slider label="Gemeindeleben">
          {ministries.map((ministry, index) => (
            <MinistryCard ministry={ministry} index={index} />
          ))}
        </Slider>
      )
    }
    <p class="more-hint">… und noch vieles mehr.</p>
  </Section>
</BaseLayout>

<style>
  .more-hint {
    margin-top: var(--sp-3);
    color: var(--text-secondary);
    font-style: italic;
  }
</style>
