---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Section from '../components/Section.astro';
import { CONTACT } from '../consts';

// Eigene .astro-Route statt Markdown in src/content/pages/ (anders als
// /impressum, /datenschutz, /spenden): Astros Markdown-Pipeline dekodiert
// &#64; vor der GFM-Autolink-Erkennung und macht daraus einen mailto:-Link
// (CLAUDE.md Regel 8 verbietet genau das, siehe Kommentar in
// content/pages/impressum.md). Hier ist die Adresse der Hauptinhalt und soll
// normal lesbar bleiben, deshalb das &#64;-Muster aus Footer.astro direkt im
// Template.
---

<BaseLayout
  title="Kontakt"
  description="So erreichst du Arche Bremen: die Funktions-E-Mail-Adresse des Gründungsteams, wer antwortet und wie lange es dauert."
>
  <PageHeader
    eyebrow="Sag einfach Moin"
    title="Kontakt"
    cloud={2}
    lead="Wir freuen uns darauf, dich schon bald zu unserem ersten Gottesdienst vor Ort in Bremen begrüßen zu dürfen. Bis es so weit ist: Melde dich gerne bei uns, wenn du Interesse oder Fragen hast — oder einfach mal Moin sagen willst."
  />

  <Section tone="light" width="measure">

    <p class="mail">
      <span class="cloud" aria-hidden="true"></span>
      <span class="mail-body">
        <span class="mail-label">E-Mail</span>
        <span class="mail-address">{CONTACT.local}&#64;{CONTACT.domain}</span>
      </span>
    </p>

    {/* .prose statt nackter <p>: Der Text hat seit September 2026 eine
        Liste, und Listen sind im Projekt ausschließlich dort gestaltet
        (global.css). Ohne die Klasse stünde hier die Browser-Voreinstellung
        mit ihrem 40px-Einzug — ein Abstandswert, den das Designsystem nicht
        kennt. Nebeneffekt, erwünscht: Der Fließtext bekommt damit auch
        Silbentrennung und `text-wrap: pretty` wie jede andere Textseite. */}
    <div class="prose">
      <p>
        Schreib uns einfach, was dich bewegt: Hast du Fragen zum Glauben,
        Interesse an der Gemeindegründung, möchtest du mitarbeiten — oder bist
        du neu in Bremen und suchst eine Gemeinde? Wir antworten dir in der
        Regel innerhalb einer Woche.
      </p>
      <p>
        Deine Nachricht landet direkt bei unserem Mitarbeiterteam. Wenn du
        wissen möchtest, wer bei uns die Verantwortung für die Lehre und das
        Leben der Gemeinde hat, schau gerne unter{' '}
        <a href="/gemeindeleitung">Gemeindeleitung</a> vorbei.
      </p>
      <p>Weitere Infos für dich:</p>
      <ul>
        <li>
          <strong>Gottesdienste:</strong> Sobald wir einen festen Ort in Bremen
          haben, findest du die genaue Anfahrt hier.
        </li>
        <li>
          <strong>Mitbeten &amp; Mitbauen:</strong> Unsere aktuellen
          Gebetsanliegen teilen wir direkt auf der{' '}
          <a href="/#mitbauen">Startseite</a>. Wenn du uns finanziell
          unterstützen möchtest, findest du alle Angaben unter{' '}
          <a href="/spenden">Spenden</a>.
        </li>
      </ul>
      <p>
        Anschrift und inhaltlich Verantwortlicher stehen im{' '}
        <a href="/impressum">Impressum</a>.
      </p>
    </div>
  </Section>
</BaseLayout>

<style>
  /* Die Adresse ist der Inhalt dieser Seite und bekommt deshalb die
     stärkste Fläche, die das Projekt hat: dieselbe Wolkenkachel wie
     Gemeindeleben, Predigten und Glaubensbekenntnis (siehe
     MinistryCard.astro). Bis September 2026 war es die letzte Fläche der
     alten Bildsprache — blassorange mit linker Akzentkante — und stand
     nach dem Umbau aller Kacheln sichtbar daneben. */
  .mail {
    position: relative;
    isolation: isolate;
    display: block;
    overflow: clip;
    border-radius: var(--radius-lg);
    background-color: var(--bg-inverted);
    background-image: var(--scrim-card);
    color: var(--text-on-dark);
    box-shadow: var(--shadow-card);
    margin: var(--sp-5) 0;
  }

  .cloud {
    position: absolute;
    inset: -26%;
    z-index: -1;
    background-image: var(--cloud-2);
  }

  @media (prefers-reduced-motion: no-preference) {
    .cloud {
      animation: cloud-drift 14s var(--ease-in-out) infinite alternate;
    }

    @keyframes cloud-drift {
      from {
        translate: -6% -4%;
        rotate: -10deg;
      }
      to {
        translate: 6% 4%;
        rotate: 10deg;
      }
    }
  }

  .mail-body {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    row-gap: var(--sp-2);
    padding: var(--sp-5) var(--sp-4);
  }

  .mail-label {
    font-family: var(--font-display);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
    font-size: var(--fs-xs);
    color: color-mix(in srgb, var(--text-on-dark) 78%, transparent);
  }

  .mail-address {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--fs-l);
    line-height: var(--lh-tight);
    letter-spacing: var(--tracking-tight);
    overflow-wrap: anywhere;
  }
</style>
