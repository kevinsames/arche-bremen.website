---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/Section.astro';
import SermonDetail from '../../components/SermonDetail.astro';
import { getSermons } from '../../lib/sanity';

export async function getStaticPaths() {
  const sermons = await getSermons();
  return sermons.map((sermon) => ({
    params: { slug: sermon.slug },
    props: { sermon },
  }));
}

const { sermon } = Astro.props;
const preacherProfiles = await getCollection('elders');
const profile = preacherProfiles.find((p) => p.id === sermon.preacher.slug);
---

<BaseLayout title={sermon.title} description={sermon.description}>
  <Section tone="dark" width="measure">
    <p><a href="/predigten">&larr; Alle Predigten</a></p>
    <h1>{sermon.title}</h1>
  </Section>

  <Section tone="light" width="measure">
    <SermonDetail sermon={sermon} profile={profile} />
  </Section>
</BaseLayout>
