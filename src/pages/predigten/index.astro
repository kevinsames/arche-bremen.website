---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/Section.astro';
import SermonCard from '../../components/SermonCard.astro';
import { getSermons } from '../../lib/sanity';

// Chronologische Liste, kein Filter-UI (siehe CLAUDE.md — Filter erst ab
// ca. 50 Einträgen).
const sermons = await getSermons();
const preacherProfiles = await getCollection('preachers');
---

<BaseLayout title="Predigten">
  <Section tone="light">
    <h1>Predigten</h1>

    {
      sermons.length === 0 ? (
        <p>Noch keine Predigten veröffentlicht.</p>
      ) : (
        <div class="sermon-grid">
          {sermons.map((sermon, index) => {
            const profile = preacherProfiles.find((p) => p.id === sermon.preacher.slug);
            return <SermonCard sermon={sermon} index={index} preacherProfile={profile} />;
          })}
        </div>
      )
    }
  </Section>
</BaseLayout>

<style>
  .sermon-grid {
    display: grid;
    gap: var(--sp-3);
    grid-template-columns: 1fr;
    margin-top: var(--sp-4);
  }

  @media (min-width: 40rem) {
    .sermon-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 64rem) {
    .sermon-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
