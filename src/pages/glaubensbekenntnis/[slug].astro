---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import Section from '../../components/Section.astro';

// Detailseite eines Artikels — Rückfallebene für Browser ohne
// Popover-Unterstützung (siehe @supports-Block in CreedCard.astro) und
// Ziel des Permalinks aus dessen Popup.
export async function getStaticPaths() {
  // Die 25 Artikel und das Vorwort bekommen eine Detailseite — alle stehen
  // als Kachel auf /glaubensbekenntnis. Die Quelle nicht: Sie steht dort als
  // Fließtext und hat keine Kachel, die hierher verlinken könnte.
  const articles = await getCollection('creed');
  return articles
    .filter((article) => article.id !== '99-quelle')
    .map((article) => ({
      params: { slug: article.id },
      props: { article },
    }));
}

const { article } = Astro.props;
const { Content } = await render(article);

// Meta-Description: der Anfang des ersten Absatzes, wörtlich — keine
// eigene Zusammenfassung, das Bekenntnis ist ein fester Text (siehe
// 99-quelle.md). Fußnotenverweise ([^19-1]) und Markdown-Sternchen raus,
// Zeilenumbrüche geglättet, auf rund 155 Zeichen an einer Wortgrenze
// gekürzt — mehr zeigt Google im Suchergebnis nicht an. Ein Satzzeichen an
// der Schnittstelle fällt weg, sonst stünde dort „erkennen, …". Ohne all das
// hätten die 26 Bekenntnisseiten keine Description und in
// WhatsApp-Vorschauen keinen Text.
const firstParagraph = (article.body ?? '').trim().split(/\n\s*\n/)[0];
const plainText = firstParagraph
  .replace(/\[\^[^\]]+\]/g, '')
  .replace(/\*/g, '')
  .replace(/\s+/g, ' ')
  .trim();
const shortened = plainText.slice(0, plainText.lastIndexOf(' ', 154)).replace(/[,;:–—]+$/, '');
const description = plainText.length <= 155 ? plainText : `${shortened} …`;
---

<BaseLayout title={`${article.data.title} — Glaubensbekenntnis`} description={description}>
  <PageHeader
    eyebrow={article.data.number != null ? `Artikel ${article.data.number}` : undefined}
    title={article.data.title}
    cloud={(article.data.number ?? 0) % 4 + 1}
    back={{ href: '/glaubensbekenntnis', label: 'Glaubensbekenntnis' }}
  />

  <Section tone="light" width="measure">
    <div class="prose">
      <Content />
    </div>
  </Section>
</BaseLayout>
