---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import SermonCard from '../components/SermonCard.astro';
import Slider from '../components/Slider.astro';
import Overlay from '../components/Overlay.astro';
import { SITE, CONTACT, FOUNDING, PRAYER_REQUESTS, WEEKLY_EVENTS } from '../consts';
import logo from '../assets/brand/arche-logo.svg';
import mark from '../assets/brand/bogen.svg';
import { getSermons, getEvents, type Event } from '../lib/sanity';
import { getCollection } from 'astro:content';

// Above the fold, ohne Scrollen: in der Gründungsphase Gründungsstatus und
// geplanter erster Gottesdienst statt Gottesdienstzeit und Adresse (siehe
// CLAUDE.md — kehrt zum 1. April 2027 um). Der Hero ist deshalb bewusst
// inhaltsgroß, nicht bildschirmgroß — keine feste vh-Höhe, die auf kleinen
// Geräten den Rest unter die Falz drückt.

// Gleiche Datenquellen wie /predigten — kein neues Datenmodell.
const sermons = (await getSermons()).slice(0, 3);
const preacherProfiles = await getCollection('elders');
const events = await getEvents();
// Ausgefallene Termine stehen oben im Hinweisblock, nicht in der
// chronologischen Liste — sonst übersieht sie, wer nur die Wochenzeiten liest.
const cancelledEvents = events.filter((event) => event.cancelled);
const upcomingEvents = events.filter((event) => !event.cancelled);
const eventDateFormatter = new Intl.DateTimeFormat('de-DE', {
  dateStyle: 'medium',
  timeStyle: 'short',
});
// Popup zeigt das Datum ausgeschrieben, die Zeile bleibt kompakt.
const eventDateLongFormatter = new Intl.DateTimeFormat('de-DE', {
  dateStyle: 'full',
  timeStyle: 'short',
});
const eventTimeFormatter = new Intl.DateTimeFormat('de-DE', { timeStyle: 'short' });

// Endzeit nur mit Uhrzeit, wenn der Termin am selben Tag endet — sonst mit
// vollem Datum (z.B. eine mehrtägige Gemeindefreizeit).
function formatEventRange(event: Event) {
  const start = new Date(event.start);
  const startText = eventDateLongFormatter.format(start);
  if (!event.end) return startText;
  const end = new Date(event.end);
  const endText =
    start.toDateString() === end.toDateString()
      ? eventTimeFormatter.format(end)
      : eventDateLongFormatter.format(end);
  return `${startText} – ${endText}`;
}

// SITE.description + Meilenstein statt eines zweiten handgeschriebenen
// Satzes — bleibt automatisch synchron, wenn FOUNDING.milestoneDate sich
// ändert oder (1. April 2027) ganz entfällt (siehe README "Offene Punkte").
const homeDescription = `${SITE.description} Erster Gottesdienst geplant für den ${FOUNDING.milestoneDate}.`;

// Structured Data, nur WebSite + Organization: Google liest WebSite.name
// von der Startseite, um den Seitennamen über den Suchergebnissen zu
// bestimmen — ohne das rät es aus Title und Domain.
//
// BEWUSST OHNE address/geo/openingHours (Church-Schema): ADDRESS in
// consts.ts ist unbestätigt (siehe dort), und die einzige bestätigte
// Adresse im Repo ist Hamburg (Doerriesweg 7, siehe impressum.md) — die des
// Rechtsträgers, nicht der Bremer Versammlung. Sie hier einzutragen würde
// Google mitteilen, die Arche Bremen sitze in Hamburg. Nachtragen, sobald
// beides feststeht: die Bremer Adresse bestätigt UND der erste Gottesdienst
// läuft (siehe README "Offene Punkte", Abschnitt Gründungsphase).
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': new URL('/#website', Astro.site).href,
      url: new URL('/', Astro.site).href,
      name: SITE.name,
      inLanguage: 'de-DE',
      publisher: { '@id': new URL('/#organization', Astro.site).href },
    },
    {
      '@type': 'Organization',
      '@id': new URL('/#organization', Astro.site).href,
      name: SITE.name,
      url: new URL('/', Astro.site).href,
      description: SITE.description,
      parentOrganization: {
        '@type': 'Organization',
        name: 'Gemeinde und Missionswerk Arche e.V.',
        url: 'https://www.arche-gemeinde.de',
      },
    },
  ],
};
---

<BaseLayout
  title={SITE.titleHome}
  titleSuffix={false}
  description={homeDescription}
  jsonLd={jsonLd}
>
  <Section tone="light">
    <h1 class="hero-title">
      <img src={logo.src} width={logo.width} height={logo.height} alt="" />
      <span class="visually-hidden">{SITE.titleHome}</span>
    </h1>
    <p class="hero-claim">{FOUNDING.claim}</p>
    <p class="hero-milestone">
      <span class="milestone-label">{FOUNDING.milestoneLabel}</span><br />
      <span class="milestone-date">{FOUNDING.milestoneDate}</span>
    </p>
    <a class="button" href="#kontakt">Schreib uns</a>

    <!-- Rein dekorativ: zeigt, dass unter dem Hero weitergeht. Kein Link,
         kein Sprungziel — der Hinweis ersetzt keine Navigation. Icon-Muster
         wie Header/Footer (siehe DESIGN.md): handgeschriebenes Inline-SVG,
         stroke="currentColor", Größe in em, aria-hidden. -->
    <span class="scroll-hint" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
           stroke-linecap="round" stroke-linejoin="round">
        <path d="M6 9l6 6 6-6" />
      </svg>
    </span>
  </Section>

  <Section tone="dark" width="measure">
    <h2>Wer wir sind</h2>
    <p>
      Wir sind eine Stationsgemeinde des{' '}
      <a href="https://www.arche-gemeinde.de" rel="noopener">
        Gemeinde- und Missionswerks Arche
      </a>{' '}
      in Hamburg. Wir bauen in Bremen eine Gemeinde auf, die auf dem Wort
      Gottes, der Bibel, und dem Evangelium von Jesus Christus ruht.
    </p>
    <p>
      Dieses Evangelium formt uns, macht uns Jesus ähnlicher und bewegt uns,
      das Evangelium von Jesus allen Menschen weiterzugeben. Wofür wir im
      Einzelnen stehen, steht in unserem <a href="/glaubensbekenntnis">Glaubensbekenntnis</a>.
    </p>
  </Section>

  <Section tone="light" width="measure">
    <h2 id="kontakt">Bete und bau mit</h2>
    <p>
      Wir stehen am Anfang und sind auf Unterstützung angewiesen. Das sind
      unsere aktuellen Gebetsanliegen:
    </p>
    <ul class="prayer-list">
      {PRAYER_REQUESTS.map((request) => <li>{request}</li>)}
    </ul>
    <p>
      Wer bei uns predigt und leitet, steht unter <a href="/gemeindeleitung">Gemeindeleitung</a>.
      Willst du mitbeten, mitbauen oder einfach mehr erfahren? Schreib uns:{' '}
      {CONTACT.local}&#64;{CONTACT.domain}
    </p>
  </Section>

  <Section tone="light">
    <h2>Predigten</h2>
    {
      sermons.length === 0 ? (
        <p>Noch keine Predigten veröffentlicht.</p>
      ) : (
        <Slider>
          {sermons.map((sermon, index) => {
            const profile = preacherProfiles.find(
              (p) => p.data.name.trim().toLowerCase() === sermon.preacher.trim().toLowerCase(),
            );
            return <SermonCard sermon={sermon} index={index} preacherProfile={profile} />;
          })}
        </Slider>
      )
    }
    <p><a href="/predigten">Alle Predigten &rarr;</a></p>
  </Section>

  <Section tone="muted">
    <img src={mark.src} width={mark.width} height={mark.height} alt="" aria-hidden="true" class="section-mark" />
    <h2>Termine</h2>

    {
      cancelledEvents.length > 0 && (
        <div class="notice">
          <h3>Bitte beachten</h3>
          <ul class="notice-list">
            {cancelledEvents.map((event) => (
              <li>
                <span class="event-title">{event.title} — fällt aus</span>
                <span class="notice-detail">
                  {eventDateLongFormatter.format(new Date(event.start))}
                  {event.location && <> &middot; {event.location}</>}
                </span>
                {event.description && <p class="notice-reason">{event.description}</p>}
              </li>
            ))}
          </ul>
        </div>
      )
    }

    {
      WEEKLY_EVENTS.length > 0 && (
        <>
          <h3>Jede Woche</h3>
          <ul class="events">
            {WEEKLY_EVENTS.map((event) => (
              <li>
                <span class="event-title">{event.title}</span>
                <span class="event-detail">
                  <span class="event-datetime">{event.weekday}, {event.time}</span> &middot; {event.location}
                </span>
              </li>
            ))}
          </ul>
        </>
      )
    }

    {
      WEEKLY_EVENTS.length === 0 && upcomingEvents.length === 0 && (
        <p>Sobald die ersten öffentlichen Termine feststehen, findest du sie hier.</p>
      )
    }

    {
      upcomingEvents.length > 0 && (
        <>
          <h3>Kommende Termine</h3>
          <ul class="events">
            {upcomingEvents.map((event) => (
              <li>
                <button
                  type="button"
                  popovertarget={`event-${event._id}`}
                  class="event-row"
                  aria-label={`Termin öffnen: ${event.title}`}
                >
                  <span class="event-title">{event.title}</span>
                  <span class="event-detail">
                    <span class="event-datetime">{eventDateFormatter.format(new Date(event.start))}</span>
                    {event.location && <> &middot; {event.location}</>}
                  </span>
                </button>

                <Overlay id={`event-${event._id}`} label={event.title}>
                  <h2>{event.title}</h2>
                  <p class="overlay-meta">{formatEventRange(event)}</p>
                  {event.location && <p class="overlay-meta">{event.location}</p>}
                  {event.description && <p>{event.description}</p>}
                </Overlay>
              </li>
            ))}
          </ul>
        </>
      )
    }
  </Section>
</BaseLayout>

<style>
  .hero-title {
    margin: 0;
    line-height: 0;
  }

  .hero-title img {
    width: min(100%, var(--size-logo-hero));
    height: auto;
  }

  /* Bogen als Stilelement (Brandbook Kapitel 4), rein dekorativ. */
  .section-mark {
    display: block;
    width: var(--size-mark);
    height: auto;
    margin: 0 auto var(--sp-4);
  }

  .hero-claim {
    font-size: var(--fs-l);
    margin: var(--sp-4) 0 0;
  }

  .hero-milestone {
    margin: var(--sp-4) 0 0;
  }

  .milestone-label {
    display: inline-block;
    font-family: var(--font-display);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: var(--tracking-display);
    font-size: var(--fs-xs);
    color: var(--text-secondary);
  }

  .milestone-date {
    font-size: var(--fs-xl);
  }

  .button {
    margin-top: var(--sp-4);
  }

  .scroll-hint {
    display: block;
    width: 1.5em;
    margin: var(--sp-5) auto 0;
    color: var(--text-secondary);
  }

  /* Blendet den Hinweis aus, sobald zu scrollen begonnen wurde — er soll
     nur zu Beginn sichtbar sein, nicht dauerhaft im Weg stehen. Gleiches
     Muster wie das Heading-Reveal in global.css: nur mit
     Scroll-Timeline-Unterstützung und ohne reduzierte Bewegung, sonst
     bleibt der Hinweis einfach stehen (kein Fehlerfall). --duration-slow
     wird vom Browser bei Scroll-Timelines ignoriert (Fortschritt kommt aus
     der Scrollposition) — hier nur aus Konsistenz mit dem Heading-Reveal
     notiert. */
  @supports (animation-timeline: scroll()) {
    @media (prefers-reduced-motion: no-preference) {
      .scroll-hint {
        animation: hint-fade var(--duration-slow) var(--ease-out) both;
        animation-timeline: scroll(root block);
        animation-range: 0 20vh;
      }

      @keyframes hint-fade {
        to {
          opacity: 0;
        }
      }
    }
  }

  h3 {
    margin: var(--sp-6) 0 0;
  }

  .events {
    list-style: none;
    padding: 0;
    margin: var(--sp-4) 0 0;
  }

  .events li {
    border-bottom: 1px solid var(--border-subtle);
    transition: border-color var(--duration-fast) var(--ease-out);
  }

  /* Fixtermine (WEEKLY_EVENTS) haben kein .event-row — nur reiner Text,
     kein Button, kein Popup (siehe Plan: keine Zusatzinfos vorhanden). */
  .events li:not(:has(.event-row)) {
    padding: var(--sp-2) 0;
    display: grid;
    grid-template-columns: 1fr;
    row-gap: var(--sp-1);
  }

  .event-row {
    display: grid;
    grid-template-columns: 1fr;
    row-gap: var(--sp-1);
    width: 100%;
    padding: var(--sp-2) 0;
    margin: 0;
    border: 0;
    background: transparent;
    font: inherit;
    color: inherit;
    text-align: left;
    cursor: pointer;
  }

  /* Ab hier passt die Titelspalte auf eine Zeile neben das Datum. Titel darf
     weiterhin umbrechen (kein Kürzen), das Datum behält seine Breite und
     rutscht dabei nicht mehr in die Titelzeile hinein wie noch mit Flex und
     justify-content: space-between — siehe Plan. column-gap ist bewusst
     größer als das sonst hier übliche --sp-4: er ist zugleich der
     Mindestabstand, auf den die Titelspalte schrumpft, bevor sie umbricht
     (minmax(0, 1fr) gibt ihr keine andere Untergrenze). Mit --sp-4 wirkte
     der Moment kurz vor dem Umbruch noch eng; --sp-5 bricht früher um und
     lässt spürbar Luft. */
  @media (min-width: 48rem) {
    .events li:not(:has(.event-row)),
    .event-row {
      grid-template-columns: minmax(0, 1fr) auto;
      column-gap: var(--sp-5);
      row-gap: 0;
      align-items: baseline;
    }

    .event-detail {
      text-align: right;
    }
  }

  .events li:has(.event-row:hover),
  .events li:has(.event-row:focus-visible) {
    border-color: var(--c-blue);
  }

  @supports not selector(:popover-open) {
    .event-row {
      cursor: default;
    }
  }

  .event-title {
    font-family: var(--font-display);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: var(--tracking-display);
    font-size: var(--fs-xs);
  }

  .event-detail {
    color: var(--text-secondary);
  }

  /* Datum und Uhrzeit sollen nicht mittendrin umbrechen — der Ortsteil
     danach bleibt umbrechbar, siehe Plan. */
  .event-datetime {
    white-space: nowrap;
  }

  .overlay-meta {
    color: var(--text-secondary);
    margin: var(--sp-2) 0 0;
  }

  /* Hinweisblock für abgesagte Termine — eigene Klassen statt .events,
     damit der Ausfall optisch nicht wie ein normaler Terminlink wirkt und
     kein Button/Overlay braucht (der Grund muss ohne Klick lesbar sein). */
  .notice {
    background: var(--surface-warm-alt);
    border-left: 3px solid var(--accent-warm-alt);
    border-radius: var(--radius-md);
    padding: var(--sp-4);
    margin-top: var(--sp-4);
  }

  .notice h3 {
    margin-top: 0;
  }

  .notice-list {
    list-style: none;
    padding: 0;
    margin: var(--sp-3) 0 0;
  }

  .notice-list li {
    display: grid;
    row-gap: var(--sp-1);
  }

  .notice-list li + li {
    margin-top: var(--sp-3);
  }

  .notice-detail,
  .notice-reason {
    color: var(--text-secondary);
  }

  .notice-reason {
    margin: 0;
  }

  /* Gebetsanliegen — gleiche Fläche wie .notice (Zweitverwendung, siehe
     DESIGN.md), aber eigene Klasse: eigener Inhalt (schlichte Liste ohne
     Titel/Detail/Grund-Struktur), keine gemeinsame Abstraktion. */
  .prayer-list {
    list-style: none;
    padding: var(--sp-4);
    margin: var(--sp-4) 0;
    background: var(--surface-warm-alt);
    border-left: 3px solid var(--accent-warm-alt);
    border-radius: var(--radius-md);
    display: grid;
    row-gap: var(--sp-2);
  }
</style>
