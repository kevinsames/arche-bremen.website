---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import SermonCard from '../components/SermonCard.astro';
import Slider from '../components/Slider.astro';
import Overlay from '../components/Overlay.astro';
import { Image } from 'astro:assets';
import { SITE, FOUNDING, PRAYER_REQUESTS, WEEKLY_EVENTS } from '../consts';
import logoWhite from '../assets/brand/arche-logo-white.svg';
import mark from '../assets/brand/bogen.svg';
import marktplatz from '../assets/photos/bremen-marktplatz.jpg';
import { getSermons, getEvents, type Event } from '../lib/sanity';
import { getCollection } from 'astro:content';

// Above the fold, ohne Scrollen: in der Gründungsphase Gründungsstatus und
// geplanter erster Gottesdienst statt Gottesdienstzeit und Adresse (siehe
// CLAUDE.md — kehrt zum 2. Mai 2027 um). Der Hero ist deshalb bewusst
// inhaltsgroß, nicht bildschirmgroß — keine feste vh-Höhe, die auf kleinen
// Geräten den Rest unter die Falz drückt. Seit September 2026 steht das
// Ortsbild hinter dem Hero statt als eigenes Band in der Seitenmitte (siehe
// DESIGN.md, Abschnitt „Bildwelt"); Anspruch und Meilenstein bleiben
// unverändert im ersten Bildschirm.

// Gleiche Datenquellen wie /predigten — kein neues Datenmodell.
const sermons = (await getSermons()).slice(0, 3);
const preacherProfiles = await getCollection('elders');
const events = await getEvents();
// Ausgefallene Termine stehen oben im Hinweisblock, nicht in der
// chronologischen Liste — sonst übersieht sie, wer nur die Wochenzeiten liest.
const cancelledEvents = events.filter((event) => event.cancelled);
const upcomingEvents = events.filter((event) => !event.cancelled);
const eventDateFormatter = new Intl.DateTimeFormat('de-DE', {
  dateStyle: 'medium',
  timeStyle: 'short',
});
// Popup zeigt das Datum ausgeschrieben, die Zeile bleibt kompakt.
const eventDateLongFormatter = new Intl.DateTimeFormat('de-DE', {
  dateStyle: 'full',
  timeStyle: 'short',
});
const eventTimeFormatter = new Intl.DateTimeFormat('de-DE', { timeStyle: 'short' });

// Endzeit nur mit Uhrzeit, wenn der Termin am selben Tag endet — sonst mit
// vollem Datum (z.B. eine mehrtägige Gemeindefreizeit).
function formatEventRange(event: Event) {
  const start = new Date(event.start);
  const startText = eventDateLongFormatter.format(start);
  if (!event.end) return startText;
  const end = new Date(event.end);
  const endText =
    start.toDateString() === end.toDateString()
      ? eventTimeFormatter.format(end)
      : eventDateLongFormatter.format(end);
  return `${startText} – ${endText}`;
}

// SITE.description + Meilenstein statt eines zweiten handgeschriebenen
// Satzes — bleibt automatisch synchron, wenn FOUNDING.milestoneDate sich
// ändert oder (2. Mai 2027) ganz entfällt (siehe README "Offene Punkte").
const homeDescription = `${SITE.description} Erster Gottesdienst geplant für den ${FOUNDING.milestoneDate}.`;

// Structured Data, nur WebSite + Organization: Google liest WebSite.name
// von der Startseite, um den Seitennamen über den Suchergebnissen zu
// bestimmen — ohne das rät es aus Title und Domain.
//
// BEWUSST OHNE address/geo/openingHours (Church-Schema): ADDRESS in
// consts.ts ist unbestätigt (siehe dort), und die einzige bestätigte
// Adresse im Repo ist Hamburg (Doerriesweg 7, siehe impressum.md) — die des
// Rechtsträgers, nicht der Bremer Versammlung. Sie hier einzutragen würde
// Google mitteilen, die Arche Bremen sitze in Hamburg. Nachtragen, sobald
// beides feststeht: die Bremer Adresse bestätigt UND der erste Gottesdienst
// läuft (siehe README "Offene Punkte", Abschnitt Gründungsphase).
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': new URL('/#website', Astro.site).href,
      url: new URL('/', Astro.site).href,
      name: SITE.name,
      inLanguage: 'de-DE',
      publisher: { '@id': new URL('/#organization', Astro.site).href },
    },
    {
      '@type': 'Organization',
      '@id': new URL('/#organization', Astro.site).href,
      name: SITE.name,
      url: new URL('/', Astro.site).href,
      description: SITE.description,
      parentOrganization: {
        '@type': 'Organization',
        name: 'Gemeinde und Missionswerk Arche e.V.',
        url: 'https://www.arche-gemeinde.de',
      },
    },
  ],
};
---

<BaseLayout
  title={SITE.titleHome}
  titleSuffix={false}
  description={homeDescription}
  jsonLd={jsonLd}
>
  <!-- Hero mit Ortsbild. Steht bewusst außerhalb von Section.astro: dessen
       .container würde das Bild auf Inhaltsbreite begrenzen, hier läuft es
       Kante zu Kante. Die Höhe kommt aus dem Inhalt, nicht aus einer
       Viewport-Einheit (siehe Kommentar im Frontmatter). -->
  <section class="hero">
    <Image
      src={marktplatz}
      alt=""
      width={1920}
      widths={[640, 960, 1280, 1600, 1920]}
      sizes="100vw"
      format="webp"
      quality={55}
      loading="eager"
      class="hero-photo"
    />
    <div class="hero-inner">
      <h1 class="hero-title">
        <img src={logoWhite.src} width={logoWhite.width} height={logoWhite.height} alt="" />
        <span class="visually-hidden">{SITE.titleHome}</span>
      </h1>
      <p class="hero-claim">{FOUNDING.claim}</p>
      <p class="hero-actions">
        <a class="button button--accent button--arrow" href="/kontakt">Schreib uns</a>
      </p>

      <!-- Meilenstein als Fußzeile des Heros: bleibt dadurch im ersten
           Bildschirm, ohne mit dem Anspruch darüber um Größe zu
           konkurrieren. -->
      <p class="hero-milestone">
        <span class="eyebrow">{FOUNDING.milestoneLabel}</span>
        <span class="milestone-date">{FOUNDING.milestoneDate}</span>
      </p>
    </div>
  </section>

  <Section tone="dark">
    <div class="split">
      <h2>Wer wir sind</h2>
      <div class="split-body">
        <p>
          Wir sind eine Stationsgemeinde des{' '}
          <a href="https://www.arche-gemeinde.de" rel="noopener">
            Gemeinde- und Missionswerks Arche
          </a>{' '}
          in Hamburg. Wir bauen in Bremen eine Gemeinde auf, die auf dem Wort
          Gottes, der Bibel und dem Evangelium von Jesus Christus ruht.
        </p>
        <p>
          Dieses Evangelium formt uns, macht uns Jesus ähnlicher und bewegt uns,
          seine gute Nachricht allen Menschen weiterzugeben. Was wir im Einzelnen
          glauben, erfährst du in unserem <a href="/glaubensbekenntnis">Glaubensbekenntnis</a>.
        </p>
      </div>
    </div>
  </Section>

  <!-- Datumsfläche: dieselbe Information wie im Hero, hier als
       typografisches Schaubild. Gelb trägt ausschließlich die Fläche, die
       Schrift bleibt Dunkles Blau (siehe Section.astro, tone="accent"). -->
  <Section tone="accent">
    <div class="milestone">
      <p class="milestone-head">
        <span class="eyebrow">{FOUNDING.milestoneLabel}</span>
        <span class="milestone-weekday">{FOUNDING.milestoneWeekday}</span>
      </p>
      <p class="numeral">
        <time datetime={FOUNDING.milestoneIso}>
          {FOUNDING.milestoneDay}<span class="numeral-slash">/</span>{FOUNDING.milestoneMonth}
        </time>
      </p>
      <p class="milestone-foot">
        <span class="milestone-year">{FOUNDING.milestoneYear}</span>
        <span class="milestone-note">Ort und Uhrzeit stehen noch nicht fest.</span>
      </p>
    </div>
  </Section>

  <Section tone="light">
    <div class="split">
      <h2 id="mitbauen">Werde Teil unserer Vision</h2>
      <div class="split-body">
        <p>
          Wir stehen am Anfang und sind auf Unterstützung angewiesen. Das sind
          unsere aktuellen Gebetsanliegen:
        </p>
      </div>
    </div>

    <ol class="prayer-list">
      {
        PRAYER_REQUESTS.map((request, index) => (
          <li data-reveal>
            <span class="prayer-number">{String(index + 1).padStart(2, '0')}</span>
            <span class="prayer-text">{request}</span>
          </li>
        ))
      }
    </ol>

    <div class="split-body outro">
      <p>
        Willst du mitbeten, die entstehende Gemeinde mitaufbauen oder einfach
        mehr erfahren? <a href="/kontakt">Schreib uns</a> gerne.
      </p>
      <p>
        Mehr über uns und darüber, was wir glauben, erfährst du auch unter den
        Punkten <a href="/gemeindeleitung">Gemeindeleitung</a> bzw.{' '}
        <a href="/glaubensbekenntnis">Glaubensbekenntnis</a>.
      </p>
    </div>
  </Section>

  <Section tone="light">
    <div class="section-head">
      <h2>Predigten</h2>
      <a class="head-link" href="/predigten">Alle Predigten &rarr;</a>
    </div>
    {
      sermons.length === 0 ? (
        <p class="empty">Noch keine Predigten veröffentlicht.</p>
      ) : (
        <Slider>
          {sermons.map((sermon) => {
            const profile = preacherProfiles.find(
              (p) => p.data.name.trim().toLowerCase() === sermon.preacher.trim().toLowerCase(),
            );
            return <SermonCard sermon={sermon} preacherProfile={profile} />;
          })}
        </Slider>
      )
    }
  </Section>

  <Section tone="muted">
    <img src={mark.src} width={mark.width} height={mark.height} alt="" aria-hidden="true" class="section-mark" />
    <h2>Termine</h2>

    {
      cancelledEvents.length > 0 && (
        <div class="notice">
          <h3>Bitte beachten</h3>
          <ul class="notice-list">
            {cancelledEvents.map((event) => (
              <li>
                <span class="event-title">{event.title} — fällt aus</span>
                <span class="notice-detail">
                  {eventDateLongFormatter.format(new Date(event.start))}
                  {event.location && <> &middot; {event.location}</>}
                </span>
                {event.description && <p class="notice-reason">{event.description}</p>}
              </li>
            ))}
          </ul>
        </div>
      )
    }

    {
      WEEKLY_EVENTS.length > 0 && (
        <>
          <h3>Jede Woche</h3>
          <ul class="events">
            {WEEKLY_EVENTS.map((event) => (
              <li>
                <span class="event-title">{event.title}</span>
                <span class="event-detail">
                  <span class="event-datetime">{event.weekday}, {event.time}</span> &middot; {event.location}
                </span>
              </li>
            ))}
          </ul>
        </>
      )
    }

    {
      WEEKLY_EVENTS.length === 0 && upcomingEvents.length === 0 && (
        <p class="empty">Sobald die ersten öffentlichen Termine feststehen, findest du sie hier.</p>
      )
    }

    {
      upcomingEvents.length > 0 && (
        <>
          <h3>Kommende Termine</h3>
          <ul class="events">
            {upcomingEvents.map((event) => (
              <li>
                <button
                  type="button"
                  popovertarget={`event-${event._id}`}
                  class="event-row"
                  aria-label={`Termin öffnen: ${event.title}`}
                >
                  <span class="event-title">{event.title}</span>
                  <span class="event-detail">
                    <span class="event-datetime">{eventDateFormatter.format(new Date(event.start))}</span>
                    {event.location && <> &middot; {event.location}</>}
                  </span>
                </button>

                <Overlay id={`event-${event._id}`} label={event.title}>
                  <h2>{event.title}</h2>
                  <p class="overlay-meta">{formatEventRange(event)}</p>
                  {event.location && <p class="overlay-meta">{event.location}</p>}
                  {event.description && <p>{event.description}</p>}
                </Overlay>
              </li>
            ))}
          </ul>
        </>
      )
    }
  </Section>

  <!-- Abschließender Aufruf. Dunkles Band direkt über dem ebenfalls dunklen
       Fuß — beide lesen sich als ein zusammenhängender Abschluss der Seite.
       Der Satz stammt aus /kontakt und steht hier bewusst ein zweites Mal:
       er ist der Einstieg in genau diese Seite. -->
  <Section tone="dark">
    <div class="closing">
      <span class="eyebrow">Kontakt</span>
      <h2 class="closing-title">Schreib uns</h2>
      <p>
        Es gibt noch keinen öffentlichen Gottesdienst, zu dem wir dich einladen
        könnten — aber es gibt uns, und über jede Nachricht freuen wir uns.
      </p>
      <a class="button button--outline button--arrow" href="/kontakt">Zum Kontakt</a>
    </div>
  </Section>
</BaseLayout>

<style>
  /* ---------- Hero ----------------------------------------------------
     Ortsbild, darüber der Verlauf aus tokens.css (--scrim-hero), darauf
     der Text in --text-on-dark. Die dunkelblaue Grundfarbe liegt
     zusätzlich unter dem Bild: Solange das Bild lädt oder wenn es
     ausfällt, steht der Text auf ihr statt auf Weiß. */
  .hero {
    position: relative;
    isolation: isolate;
    background-color: var(--bg-inverted);
    color: var(--text-on-dark);
  }

  .hero-photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Das Bild ist ein Querformat (etwa 2.5:1). Im hochformatigen Ausschnitt
       auf dem Telefon wird es stark beschnitten; 50% 40% hält dabei die
       Giebel im Bild statt des Pflasters. */
    object-position: 50% 40%;
    z-index: -2;
  }

  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--scrim-hero);
    z-index: -1;
  }

  .hero-inner {
    max-width: var(--width-content);
    margin-inline: auto;
    padding: clamp(var(--sp-6), 8vw, var(--sp-7)) var(--sp-3) var(--sp-4);
    /* Untergrenze, keine Viewport-Höhe: der Hero darf wachsen, wenn der
       Anspruch umbricht, drückt den Rest der Seite aber auf kleinen
       Geräten nicht unter die Falz (siehe Frontmatter). */
    min-height: 26rem;
    display: flex;
    flex-direction: column;
    gap: var(--sp-4);
  }

  @media (min-width: 48rem) {
    .hero-inner {
      min-height: 34rem;
    }
  }

  .hero-title {
    margin: 0;
    line-height: 0;
  }

  .hero-title img {
    width: min(100%, var(--size-logo-hero));
    height: auto;
  }

  /* Trägt den Anspruch als Schauzeile: Versalien mit weiter Laufweite wie
     jede Überschrift (Brandbook 2.1), aber als <p> — die h1 der Seite ist
     die Wortmarke darüber. */
  .hero-claim {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: var(--fs-xxl);
    line-height: var(--lh-tight);
    text-transform: uppercase;
    letter-spacing: var(--tracking-display);
    max-width: 18ch;
  }

  .hero-actions {
    margin: 0;
  }

  /* Schiebt den Meilenstein an die Unterkante des Heros, sobald dieser
     höher ist als sein Inhalt. */
  .hero-milestone {
    margin: auto 0 0;
    padding-top: var(--sp-3);
    border-top: 1px solid var(--border-subtle);
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--sp-1) var(--sp-4);
  }

  .milestone-date {
    font-size: var(--fs-l);
  }

  /* ---------- Wiederkehrende Bausteine dieser Seite -------------------- */

  /* Kleines Versal-Label über einer Überschrift oder Fläche. Bewusst nur
     hier definiert und nicht global: dieselbe Optik steht in mehreren
     Komponenten je einmal lokal (SermonCard .passage, CreedCard .number,
     kontakt.astro .mail-label) — Wiederholung statt gemeinsamer
     Abstraktion, siehe CLAUDE.md Regel 2. */
  .eyebrow {
    display: block;
    font-family: var(--font-display);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: var(--tracking-display);
    font-size: var(--fs-xs);
  }

  /* Redaktionelles Zweispalter-Muster: Überschrift links, Fließtext
     rechts. Unter 64rem gestapelt. */
  .split {
    display: grid;
    gap: var(--sp-3);
  }

  @media (min-width: 64rem) {
    .split {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
      gap: var(--sp-6);
      align-items: start;
    }
  }

  .split h2 {
    margin: 0;
  }

  .split-body {
    max-width: var(--measure);
  }

  .split-body p:last-child {
    margin-bottom: 0;
  }

  .outro {
    margin-top: var(--sp-5);
  }

  /* Überschriftzeile mit Link am rechten Rand (Predigten). */
  .section-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--sp-2) var(--sp-4);
    padding-bottom: var(--sp-3);
    border-bottom: 1px solid var(--border-subtle);
  }

  .section-head h2 {
    margin: 0;
  }

  .head-link {
    font-family: var(--font-display);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: var(--tracking-display);
    font-size: var(--fs-xs);
    text-decoration: none;
    border-bottom: 2px solid transparent;
    transition: border-color var(--duration-fast) var(--ease-out);
  }

  .head-link:hover,
  .head-link:focus-visible {
    border-color: var(--accent-warm);
  }

  .empty {
    margin-top: var(--sp-4);
    color: var(--text-secondary);
  }

  /* ---------- Datumsfläche -------------------------------------------- */

  .milestone {
    display: grid;
    gap: var(--sp-3);
  }

  .milestone-head,
  .milestone-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--sp-1) var(--sp-4);
    margin: 0;
  }

  .milestone-head {
    padding-bottom: var(--sp-3);
    border-bottom: 1px solid var(--text-primary);
  }

  .milestone-foot {
    padding-top: var(--sp-3);
    border-top: 1px solid var(--text-primary);
  }

  /* Der Wochentag flankiert die Zahlen als kleines Versal-Label —
     dieselbe Optik wie .eyebrow, nur ohne dessen Blockeigenschaft (er
     steht in einer Flexzeile). */
  .milestone-weekday {
    font-family: var(--font-display);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: var(--tracking-display);
    font-size: var(--fs-xs);
  }

  /* Der Ortshinweis bleibt Fließtext: ein ganzer Satz in Versalien liest
     sich als Ausruf. Farbe bleibt --text-primary — --text-secondary
     (Braun) erreicht auf Gelb nur 4.27 : 1 und verfehlt AA. */
  .milestone-note {
    font-size: var(--fs-xs);
  }

  /* Die Datumszahlen selbst. Einzige Stelle mit --fs-numeral (tokens.css):
     ein rein typografisches Schaubild, kein Fließtext. */
  .numeral {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: var(--fs-numeral);
    line-height: 1;
    letter-spacing: var(--tracking-display);
  }

  /* Der Schrägstrich trennt die Zahlen, ohne mit ihnen zu konkurrieren:
     kleiner gesetzt statt abgeblendet — eine Deckkraft unter 1 mischt auf
     Gelb ein Olivgrün ein, das nach einer vierten Marken-farbe aussieht. */
  .numeral-slash {
    font-size: 0.5em;
    margin: 0 0.12em;
    vertical-align: 0.18em;
  }

  .milestone-year {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: var(--fs-l);
    letter-spacing: var(--tracking-display);
  }

  /* ---------- Gebetsanliegen ------------------------------------------ */

  /* Bis September 2026 eine schlichte Liste auf --surface-warm-alt. Jetzt
     drei nummerierte Felder nebeneinander — gleiche Inhalte aus
     PRAYER_REQUESTS, nur als Raster statt als Aufzählung. Kein Link und
     kein Popup, deshalb auch kein Hover-Zustand: Die Felder sind Text,
     keine Kacheln (siehe DESIGN.md, Abschnitt „Kachel-Muster"). */
  .prayer-list {
    list-style: none;
    margin: var(--sp-5) 0 0;
    padding: 0;
    display: grid;
    gap: var(--sp-3);
  }

  @media (min-width: 48rem) {
    .prayer-list {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .prayer-list li {
    display: grid;
    gap: var(--sp-2);
    align-content: start;
    padding: var(--sp-4) var(--sp-3);
    border-radius: var(--radius-md);
    background-color: var(--surface-warm);
  }

  .prayer-number {
    font-family: var(--font-display);
    font-weight: 700;
    letter-spacing: var(--tracking-display);
    font-size: var(--fs-xs);
    color: var(--text-secondary);
  }

  .prayer-text {
    font-size: var(--fs-m);
    line-height: var(--lh-tight);
  }

  /* ---------- Termine -------------------------------------------------- */

  /* Bogen als Stilelement (Brandbook Kapitel 4), rein dekorativ. */
  .section-mark {
    display: block;
    width: var(--size-mark);
    height: auto;
    margin: 0 auto var(--sp-4);
  }

  h3 {
    margin: var(--sp-6) 0 0;
  }

  .events {
    list-style: none;
    padding: 0;
    margin: var(--sp-4) 0 0;
  }

  .events li {
    border-bottom: 1px solid var(--border-subtle);
    transition: border-color var(--duration-fast) var(--ease-out);
  }

  /* Fixtermine (WEEKLY_EVENTS) haben kein .event-row — nur reiner Text,
     kein Button, kein Popup (siehe Plan: keine Zusatzinfos vorhanden). */
  .events li:not(:has(.event-row)) {
    padding: var(--sp-2) 0;
    display: grid;
    grid-template-columns: 1fr;
    row-gap: var(--sp-1);
  }

  .event-row {
    display: grid;
    grid-template-columns: 1fr;
    row-gap: var(--sp-1);
    width: 100%;
    padding: var(--sp-2) 0;
    margin: 0;
    border: 0;
    background: transparent;
    font: inherit;
    color: inherit;
    text-align: left;
    cursor: pointer;
  }

  /* Ab hier passt die Titelspalte auf eine Zeile neben das Datum. Titel darf
     weiterhin umbrechen (kein Kürzen), das Datum behält seine Breite und
     rutscht dabei nicht mehr in die Titelzeile hinein wie noch mit Flex und
     justify-content: space-between — siehe Plan. column-gap ist bewusst
     größer als das sonst hier übliche --sp-4: er ist zugleich der
     Mindestabstand, auf den die Titelspalte schrumpft, bevor sie umbricht
     (minmax(0, 1fr) gibt ihr keine andere Untergrenze). Mit --sp-4 wirkte
     der Moment kurz vor dem Umbruch noch eng; --sp-5 bricht früher um und
     lässt spürbar Luft. */
  @media (min-width: 48rem) {
    .events li:not(:has(.event-row)),
    .event-row {
