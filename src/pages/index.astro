---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import SermonCard from '../components/SermonCard.astro';
import Slider from '../components/Slider.astro';
import Overlay from '../components/Overlay.astro';
import { SITE, SERVICE, ADDRESS, WEEKLY_EVENTS } from '../consts';
import logoLockup from '../assets/brand/logo-lockup-blue.jpg';
import mark from '../assets/brand/mark-blue.jpg';
import { getSermons, getEvents, type Event } from '../lib/sanity';
import { getCollection } from 'astro:content';

// Above the fold, ohne Scrollen: Gottesdienstzeit und Adresse (siehe
// CLAUDE.md). Der Hero ist deshalb bewusst inhaltsgroß, nicht
// bildschirmgroß — keine feste vh-Höhe, die auf kleinen Geräten den Rest
// unter die Falz drückt.
const mapsQuery = encodeURIComponent(
  `${ADDRESS.street}, ${ADDRESS.postalCode} ${ADDRESS.city}`,
);
const mapsUrl = `https://www.google.com/maps/search/?api=1&query=${mapsQuery}`;

// Gleiche Datenquellen wie /predigten — kein neues Datenmodell.
const sermons = (await getSermons()).slice(0, 3);
const preacherProfiles = await getCollection('elders');
const events = await getEvents();
const eventDateFormatter = new Intl.DateTimeFormat('de-DE', {
  dateStyle: 'medium',
  timeStyle: 'short',
});
// Popup zeigt das Datum ausgeschrieben, die Zeile bleibt kompakt.
const eventDateLongFormatter = new Intl.DateTimeFormat('de-DE', {
  dateStyle: 'full',
  timeStyle: 'short',
});
const eventTimeFormatter = new Intl.DateTimeFormat('de-DE', { timeStyle: 'short' });

// Endzeit nur mit Uhrzeit, wenn der Termin am selben Tag endet — sonst mit
// vollem Datum (z.B. eine mehrtägige Gemeindefreizeit).
function formatEventRange(event: Event) {
  const start = new Date(event.start);
  const startText = eventDateLongFormatter.format(start);
  if (!event.end) return startText;
  const end = new Date(event.end);
  const endText =
    start.toDateString() === end.toDateString()
      ? eventTimeFormatter.format(end)
      : eventDateLongFormatter.format(end);
  return `${startText} – ${endText}`;
}
---

<BaseLayout title={SITE.name}>
  <Section tone="light">
    <h1 class="hero-title">
      <Image src={logoLockup} alt={SITE.name} width={512} densities={[1, 2]} format="webp" quality={90} />
    </h1>
    <p class="hero-service">{SERVICE.display}</p>
    <address class="hero-address">
      {ADDRESS.street}<br />
      {ADDRESS.postalCode} {ADDRESS.city}
    </address>
    <a class="button" href={mapsUrl} target="_blank" rel="noopener">So findest du uns</a>
  </Section>

  <Section tone="dark" width="measure">
    <h2>Wer wir sind</h2>
    <p>
      Wir sind eine Stationsgemeinde des „Gemeinde- und Missionswerks Arche"
      in Hamburg. Wir bauen in Bremen eine Gemeinde auf, die auf dem Wort
      Gottes, der Bibel, und dem Evangelium von Jesus Christus ruht.
    </p>
    <p>
      Dieses Evangelium formt uns, macht uns Jesus ähnlicher und bewegt uns,
      das Evangelium von Jesus allen Menschen weiterzugeben.
    </p>
  </Section>

  <Section tone="light">
    <h2>Predigten</h2>
    {
      sermons.length === 0 ? (
        <p>Noch keine Predigten veröffentlicht.</p>
      ) : (
        <Slider>
          {sermons.map((sermon, index) => {
            const profile = preacherProfiles.find(
              (p) => p.data.name.trim().toLowerCase() === sermon.preacher.trim().toLowerCase(),
            );
            return <SermonCard sermon={sermon} index={index} preacherProfile={profile} />;
          })}
        </Slider>
      )
    }
    <p><a href="/predigten">Alle Predigten &rarr;</a></p>
  </Section>

  <Section tone="muted">
    <Image src={mark} alt="" aria-hidden="true" width={128} densities={[1, 2]} format="webp" quality={90} class="section-mark" />
    <h2>Termine</h2>

    <h3>Jede Woche</h3>
    <ul class="events">
      {
        WEEKLY_EVENTS.map((event) => (
          <li>
            <span class="event-title">{event.title}</span>
            <span class="event-detail">
              {event.weekday}, {event.time} &middot; {event.location}
            </span>
          </li>
        ))
      }
    </ul>

    {
      events.length > 0 && (
        <>
          <h3>Kommende Termine</h3>
          <ul class="events">
            {events.map((event) => (
              <li>
                <button
                  type="button"
                  popovertarget={`event-${event._id}`}
                  class="event-row"
                  aria-label={`Termin öffnen: ${event.title}`}
                >
                  <span class="event-title">{event.title}</span>
                  <span class="event-detail">
                    {eventDateFormatter.format(new Date(event.start))}
                    {event.location && <> &middot; {event.location}</>}
                  </span>
                </button>

                <Overlay id={`event-${event._id}`} label={event.title}>
                  <h2>{event.title}</h2>
                  <p class="overlay-meta">{formatEventRange(event)}</p>
                  {event.location && <p class="overlay-meta">{event.location}</p>}
                  {event.description && <p>{event.description}</p>}
                </Overlay>
              </li>
            ))}
          </ul>
        </>
      )
    }
  </Section>
</BaseLayout>

<style>
  .hero-title {
    margin: 0;
    line-height: 0;
  }

  /* Interim-Logo als JPEG ohne Alphakanal — mix-blend-mode macht den
     weißen Hintergrund transparent (siehe DESIGN.md, Abschnitt Logo,
     gleiche Begründung wie im Header). */
  .hero-title :global(img) {
    width: min(100%, var(--size-logo-hero));
    height: auto;
    mix-blend-mode: multiply;
  }

  /* Bogen als Stilelement (Brandbook Kapitel 4), rein dekorativ. Gleicher
     Interim-Hack wie Header/Hero-Logo, siehe DESIGN.md. */
  .section-mark {
    display: block;
    width: var(--size-mark);
    height: auto;
    margin: 0 auto var(--sp-4);
    mix-blend-mode: multiply;
  }

  .hero-service {
    font-size: var(--fs-l);
    margin: var(--sp-4) 0 0;
  }

  .hero-address {
    font-style: normal;
    color: var(--text-secondary);
    margin: var(--sp-1) 0 0;
  }

  .button {
    margin-top: var(--sp-4);
  }

  h3 {
    margin: var(--sp-6) 0 0;
  }

  .events {
    list-style: none;
    padding: 0;
    margin: var(--sp-4) 0 0;
  }

  .events li {
    border-bottom: 1px solid var(--border-subtle);
    transition: border-color var(--duration-fast) var(--ease-out);
  }

  /* Fixtermine (WEEKLY_EVENTS) haben kein .event-row — nur reiner Text,
     kein Button, kein Popup (siehe Plan: keine Zusatzinfos vorhanden). */
  .events li:not(:has(.event-row)) {
    padding: var(--sp-2) 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
    justify-content: space-between;
  }

  .event-row {
    display: flex;
    width: 100%;
    flex-wrap: wrap;
    gap: var(--sp-2);
    justify-content: space-between;
    padding: var(--sp-2) 0;
    margin: 0;
    border: 0;
    background: transparent;
    font: inherit;
    color: inherit;
    text-align: left;
    cursor: pointer;
  }

  .events li:has(.event-row:hover),
  .events li:has(.event-row:focus-visible) {
    border-color: var(--c-blue);
  }

  @supports not selector(:popover-open) {
    .event-row {
      cursor: default;
    }
  }

  .event-title {
    font-family: var(--font-display);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: var(--tracking-display);
    font-size: var(--fs-xs);
  }

  .event-detail {
    color: var(--text-secondary);
  }

  .overlay-meta {
    color: var(--text-secondary);
    margin: var(--sp-2) 0 0;
  }
</style>
