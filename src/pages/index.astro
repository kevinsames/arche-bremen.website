---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE, SERVICE, ADDRESS } from '../consts';
---

<BaseLayout title={SITE.name}>
  <section class="service-info">
    <p class="service-time">{SERVICE.display}</p>
    <address>
      {ADDRESS.street}<br />
      {ADDRESS.postalCode} {ADDRESS.city}
    </address>
  </section>

  <p class="intro">
    PLATZHALTER: kurzer Einleitungstext zur Gemeinde folgt hier.
  </p>
</BaseLayout>

<style>
  .service-info {
    background-color: var(--bg-muted);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    padding: var(--sp-3);
    margin-top: var(--sp-3);
  }

  .service-time {
    font-size: var(--fs-l);
    font-weight: bold;
    margin: 0 0 var(--sp-2);
  }

  address {
    font-style: normal;
    color: var(--text-secondary);
  }

  .intro {
    margin-top: var(--sp-4);
  }
</style>
