---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import SermonCard from '../components/SermonCard.astro';
import Slider from '../components/Slider.astro';
import Overlay from '../components/Overlay.astro';
import { Image } from 'astro:assets';
import { SITE, FOUNDING, PRAYER_REQUESTS, WEEKLY_EVENTS } from '../consts';
import logoWhite from '../assets/brand/arche-logo-white.svg';
import mark from '../assets/brand/bogen.svg';
import marktplatz from '../assets/photos/bremen-marktplatz.jpg';
import { getSermons, getEvents, type Event } from '../lib/sanity';
import { getCollection } from 'astro:content';

// Above the fold, ohne Scrollen: in der Gründungsphase Gründungsstatus und
// geplanter erster Gottesdienst statt Gottesdienstzeit und Adresse (siehe
// CLAUDE.md — kehrt mit dem ersten Gottesdienst um, geplant Frühjahr 2027). Der Hero ist deshalb bewusst
// inhaltsgroß, nicht bildschirmgroß — keine feste vh-Höhe, die auf kleinen
// Geräten den Rest unter die Falz drückt. Seit September 2026 steht das
// Ortsbild hinter dem Hero statt als eigenes Band in der Seitenmitte (siehe
// DESIGN.md, Abschnitt „Bildwelt"); Anspruch und Meilenstein bleiben
// unverändert im ersten Bildschirm.

// Gleiche Datenquellen wie /predigten — kein neues Datenmodell.
const sermons = (await getSermons()).slice(0, 3);
const preacherProfiles = await getCollection('elders');
const events = await getEvents();
// Ausgefallene Termine stehen oben im Hinweisblock, nicht in der
// chronologischen Liste — sonst übersieht sie, wer nur die Wochenzeiten liest.
const cancelledEvents = events.filter((event) => event.cancelled);
const upcomingEvents = events.filter((event) => !event.cancelled);
const eventDateFormatter = new Intl.DateTimeFormat('de-DE', {
  dateStyle: 'medium',
  timeStyle: 'short',
});
// Popup zeigt das Datum ausgeschrieben, die Zeile bleibt kompakt.
const eventDateLongFormatter = new Intl.DateTimeFormat('de-DE', {
  dateStyle: 'full',
  timeStyle: 'short',
});
const eventTimeFormatter = new Intl.DateTimeFormat('de-DE', { timeStyle: 'short' });

// Endzeit nur mit Uhrzeit, wenn der Termin am selben Tag endet — sonst mit
// vollem Datum (z.B. eine mehrtägige Gemeindefreizeit).
function formatEventRange(event: Event) {
  const start = new Date(event.start);
  const startText = eventDateLongFormatter.format(start);
  if (!event.end) return startText;
  const end = new Date(event.end);
  const endText =
    start.toDateString() === end.toDateString()
      ? eventTimeFormatter.format(end)
      : eventDateLongFormatter.format(end);
  return `${startText} – ${endText}`;
}

// SITE.description + Meilenstein statt eines zweiten handgeschriebenen
// Satzes — bleibt automatisch synchron, wenn FOUNDING.milestoneDate sich
// ändert oder mit dem ersten Gottesdienst ganz entfällt (siehe README
// "Offene Punkte").
const homeDescription = `${SITE.description} Erster Gottesdienst im ${FOUNDING.milestoneDate} in ${FOUNDING.milestonePlace} geplant.`;


// Structured Data, nur WebSite + Organization: Google liest WebSite.name
// von der Startseite, um den Seitennamen über den Suchergebnissen zu
// bestimmen — ohne das rät es aus Title und Domain.
//
// BEWUSST OHNE address/geo/openingHours (Church-Schema): ADDRESS in
// consts.ts ist unbestätigt (siehe dort), und die einzige bestätigte
// Adresse im Repo ist Hamburg (Doerriesweg 7, siehe impressum.md) — die des
// Rechtsträgers, nicht der Bremer Versammlung. Sie hier einzutragen würde
// Google mitteilen, die Arche Bremen sitze in Hamburg. Nachtragen, sobald
// beides feststeht: die Bremer Adresse bestätigt UND der erste Gottesdienst
// läuft (siehe README "Offene Punkte", Abschnitt Gründungsphase).
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': new URL('/#website', Astro.site).href,
      url: new URL('/', Astro.site).href,
      name: SITE.name,
      inLanguage: 'de-DE',
      publisher: { '@id': new URL('/#organization', Astro.site).href },
    },
    {
      '@type': 'Organization',
      '@id': new URL('/#organization', Astro.site).href,
      name: SITE.name,
      url: new URL('/', Astro.site).href,
      description: SITE.description,
      parentOrganization: {
        '@type': 'Organization',
        name: 'Gemeinde und Missionswerk Arche e.V.',
        url: 'https://www.arche-gemeinde.de',
      },
    },
  ],
};
---

<BaseLayout
  title={SITE.titleHome}
  titleSuffix={false}
  description={homeDescription}
  jsonLd={jsonLd}
>
  <!-- Hero mit Ortsbild. Steht bewusst außerhalb von Section.astro: dessen
       .container würde das Bild auf Inhaltsbreite begrenzen, hier läuft es
       Kante zu Kante. Die Höhe kommt aus dem Inhalt, nicht aus einer
       Viewport-Einheit (siehe Kommentar im Frontmatter). -->
  <section class="hero">
    <Image
      src={marktplatz}
      alt=""
      width={1920}
      widths={[640, 960, 1280, 1600, 1920]}
      sizes="100vw"
      format="webp"
      quality={55}
      loading="eager"
      class="hero-photo"
    />

    <!-- Bogen aus dem Lockup (Brandbook Kapitel 4) als großes Stilelement,
         rein dekorativ. Als CSS-Maske eingebunden statt als <img>: Die
         Datei trägt die dunkelblaue Füllung des offiziellen Lockups, hier
         soll die Form aber Gelb sein — eine zweite, eingefärbte SVG-Datei
         wäre eine Kopie, die bei jeder Logo-Korrektur mitgepflegt werden
         müsste. -->
    <span class="hero-mark" style={`--mark: url(${mark.src})`} aria-hidden="true"></span>

    <div class="hero-inner">
      {/* Diese Zeile steht auf dem Telefon in Gelb, auf dem Desktop in
          Weiß. Die Farbe kommt aus der Medienabfrage im Stilblock unten,
          nicht aus einer Klasse hier. Begründung und Messungen in
          DESIGN.md, „Gelbe Dachzeile im Hero". */}
      <p class="eyebrow">{SITE.name} &middot; Evangelisch-reformierte Freikirche</p>
      <h1 class="hero-claim">
        {FOUNDING.claim} <span class="accent">{FOUNDING.claimAccent}</span>
      </h1>

      <p class="milestone-label">
        <span class="eyebrow">{FOUNDING.milestoneLabel}</span>
        <span class="milestone-date">{FOUNDING.milestoneDate}</span>
      </p>

      <p class="hero-actions">
        <a class="button button--accent button--arrow" href="/kontakt">Schreib uns</a>
        <a class="button button--ghost button--arrow" href="#wer-wir-sind">Mehr erfahren</a>
      </p>
    </div>
  </section>

  <Section tone="dark">
    <div class="split">
      <div>
        <p class="eyebrow eyebrow--accent">Wer wir sind</p>
        <h2 id="wer-wir-sind">Auf festem Grund gebaut.</h2>
      </div>
      <div class="split-body">
        <p>
          Wir sind eine Stationsgemeinde des{' '}
          <a href="https://www.arche-gemeinde.de" rel="noopener">
            Gemeinde- und Missionswerks Arche
          </a>{' '}
          in Hamburg. Wir bauen in Bremen eine Gemeinde auf, die auf dem Wort
          Gottes, der Bibel und dem Evangelium von Jesus Christus ruht.
        </p>
        <p>
          Dieses Evangelium formt uns, macht uns Jesus ähnlicher und bewegt uns,
          seine gute Nachricht allen Menschen weiterzugeben. Was wir im Einzelnen
          glauben, erfährst du in unserem <a href="/glaubensbekenntnis">Glaubensbekenntnis</a>.
        </p>
        <figure class="verse">
          <blockquote>
            Denn einen anderen Grund kann niemand legen außer dem, der gelegt
            ist, welcher ist Jesus Christus.
          </blockquote>
          {/* Zitiert nach Schlachter 2000; die Quellenzeile nennt bewusst
              nur „Die Bibel" (DESIGN.md, „Bibelvers auf dunklem Grund"). */}
          <figcaption>Die Bibel · 1. Korinther 3,11</figcaption>
        </figure>
      </div>
    </div>
  </Section>

  <!-- Datumsfläche: derselbe Meilenstein wie im Hero, hier als
       typografisches Schaubild. Gelb trägt ausschließlich die Fläche, die
       Schrift bleibt Dunkles Blau (siehe Section.astro, tone="accent"). -->
  <Section tone="accent">
    <div class="milestone">
      <p class="milestone-head">
        <span class="eyebrow">{FOUNDING.milestoneLabel}</span>
        <span class="milestone-season">{FOUNDING.milestoneSeason}</span>
      </p>
      <p class="numeral">
        <time datetime={FOUNDING.milestoneYear}>{FOUNDING.milestoneYear}</time>
      </p>
      <p class="milestone-foot">
        <span class="milestone-place">{FOUNDING.milestonePlace}</span>
        <span class="milestone-note">Genaues Datum und Adresse folgen.</span>
      </p>
    </div>
  </Section>

  <Section tone="light">
    <div class="split">
      <div>
        <p class="eyebrow eyebrow--muted">Mitbeten. Mitbauen.</p>
        <h2 id="mitbauen">Werde Teil unserer Vision.</h2>
      </div>
      <div class="split-body">
        <p class="lead">
          Wir stehen am Anfang und sind auf Unterstützung angewiesen. Das sind
          unsere aktuellen Gebetsanliegen.
        </p>
      </div>
    </div>

    <ol class="prayer-list">
      {
        PRAYER_REQUESTS.map((request, index) => (
          <li style={`--cloud: var(--cloud-${(index % 4) + 1}); --reveal-offset: ${index * 4}%`} data-reveal>
            <span class="cloud" aria-hidden="true"></span>
            <span class="prayer-body">
              {/* Nur die Ziffer, ohne das Wort "Anliegen" davor. Damit ist
                  sie rein dekorativ: Die Zählung steht bereits in der
                  <ol>-Semantik, Screenreader sagen "1 von 6" ohnehin an.
                  Ein zusätzlich vorgelesenes "01" wäre Doppelung. */}
              <span class="eyebrow" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
              <span class="prayer-text">{request}</span>
            </span>
          </li>
        ))
      }
    </ol>

    <div class="split-body outro">
      <p>
        Willst du mitbeten, die entstehende Gemeinde mitaufbauen oder einfach
        mehr erfahren? <a href="/kontakt">Schreib uns</a> gerne.
      </p>
      <p>
        Mehr über uns und darüber, was wir glauben, erfährst du auch unter den
        Punkten <a href="/gemeindeleitung">Gemeindeleitung</a> bzw.{' '}
        <a href="/glaubensbekenntnis">Glaubensbekenntnis</a>.
      </p>
    </div>
  </Section>

  <Section tone="light">
    <div class="section-head">
      <div>
        <p class="eyebrow eyebrow--muted">Predigten</p>
        <h2>Worte, die prägen.</h2>
      </div>
      <a class="head-link" href="/predigten">Alle Predigten &rarr;</a>
    </div>
    {
      sermons.length === 0 ? (
        <p class="empty">Noch keine Predigten veröffentlicht.</p>
      ) : (
        <Slider label="Predigten">
          {sermons.map((sermon, index) => {
            const profile = preacherProfiles.find(
              (p) => p.data.name.trim().toLowerCase() === sermon.preacher.trim().toLowerCase(),
            );
            return <SermonCard sermon={sermon} preacherProfile={profile} index={index} />;
          })}
        </Slider>
      )
    }
  </Section>

  <Section tone="muted">
    <div class="section-head">
      <div>
        <p class="eyebrow eyebrow--muted">Termine</p>
        <h2>Was als Nächstes ansteht.</h2>
      </div>
    </div>

    {
      cancelledEvents.length > 0 && (
        <div class="notice">
          <h3>Bitte beachten</h3>
          <ul class="notice-list">
            {cancelledEvents.map((event) => (
              <li>
                <span class="event-title">{event.title} — fällt aus</span>
                <span class="notice-detail">
                  {eventDateLongFormatter.format(new Date(event.start))}
                  {event.location && <> &middot; {event.location}</>}
                </span>
                {event.description && <p class="notice-reason">{event.description}</p>}
              </li>
            ))}
          </ul>
        </div>
      )
    }

    {
      WEEKLY_EVENTS.length > 0 && (
        <>
          <h3>Jede Woche</h3>
          <ul class="events">
            {WEEKLY_EVENTS.map((event) => (
              <li>
                <span class="event-title">{event.title}</span>
                <span class="event-detail">
                  <span class="event-datetime">{event.weekday}, {event.time}</span> &middot; {event.location}
                </span>
              </li>
            ))}
          </ul>
        </>
      )
    }

    {
      WEEKLY_EVENTS.length === 0 && upcomingEvents.length === 0 && (
        <p class="empty">Sobald die ersten öffentlichen Termine feststehen, findest du sie hier.</p>
      )
    }

    {
      upcomingEvents.length > 0 && (
        <>
          <h3>Kommende Termine</h3>
          <ul class="events">
            {upcomingEvents.map((event) => (
              <li>
                <button
                  type="button"
                  popovertarget={`event-${event._id}`}
                  class="event-row"
                  aria-label={`Termin öffnen: ${event.title}`}
                >
                  <span class="event-title">{event.title}</span>
                  <span class="event-detail">
                    <span class="event-datetime">{eventDateFormatter.format(new Date(event.start))}</span>
                    {event.location && <> &middot; {event.location}</>}
                  </span>
                </button>

                <Overlay id={`event-${event._id}`} label={event.title}>
                  <Fragment slot="head">
                    <span class="kicker">Termin</span>
                    <h2>{event.title}</h2>
                  </Fragment>
                  <p class="overlay-meta">{formatEventRange(event)}</p>
                  {event.location && <p class="overlay-meta">{event.location}</p>}
                  {event.description && <p>{event.description}</p>}
                </Overlay>
              </li>
            ))}
          </ul>
        </>
      )
    }
  </Section>

  <!-- Abschließender Aufruf. Dunkles Band direkt über dem ebenfalls dunklen
       Fuß — beide lesen sich als ein zusammenhängender Abschluss der Seite.
       Der Satz stammt aus /kontakt und steht hier bewusst ein zweites Mal:
       er ist der Einstieg in genau diese Seite. Wer ihn hier ändert, ändert
       ihn dort mit (PageHeader-`lead` in kontakt.astro). -->
  <Section tone="dark">
    <div class="closing">
      <h2 class="closing-title">Sag einfach <span class="accent">Moin.</span></h2>
      <p>
        Wir freuen uns darauf, dich schon bald zu unserem ersten Gottesdienst
        vor Ort in Bremen begrüßen zu dürfen. Bis es so weit ist: Melde dich
        gerne bei uns, wenn du Interesse oder Fragen hast — oder einfach mal
        Hallo sagen willst.
      </p>
      <a class="button button--accent button--arrow" href="/kontakt">Zum Kontakt</a>
    </div>
  </Section>
</BaseLayout>

<style>
  /* ---------- Hero ----------------------------------------------------
     Ortsbild, darüber der Verlauf aus tokens.css (--scrim-hero), darauf
     der Text in --text-on-dark. Die dunkelblaue Grundfarbe liegt
     zusätzlich unter dem Bild: Solange das Bild lädt oder wenn es
     ausfällt, steht der Text auf ihr statt auf Weiß. */
  .hero {
    position: relative;
    isolation: isolate;
    /* Der Bogen ragt bewusst über die rechte Kante hinaus (siehe
       .hero-mark) — ohne diese Zeile schöbe er den Viewport auf. */
    overflow: clip;
    background-color: var(--bg-inverted);
    color: var(--text-on-dark);
  }

  .hero-photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Das Bild ist ein Querformat (etwa 2.5:1). Im hochformatigen Ausschnitt
       auf dem Telefon wird es stark beschnitten; 50% 40% hält dabei die
       Giebel im Bild statt des Pflasters. */
    object-position: 50% 40%;
    z-index: -3;
  }

  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--scrim-hero);
    z-index: -1;
  }

  /* Der Bogen als Maske: Form aus bogen.svg, Farbe aus dem Token. Liegt
     zwischen Foto und Verlauf, damit der Verlauf ihn nach unten hin
     ausblendet statt ihn als Aufkleber stehen zu lassen. */
  .hero-mark {
    position: absolute;
    /* Über dem Verlauf, nicht darunter: Unter --scrim-hero mischt sich
       das Gelb mit dem Dunkelblau zu einem stumpfen Oliv. Ohne z-index
       liegt es trotzdem hinter .hero-inner, weil das im Markup danach
       kommt. */
    top: 4%;
    right: -3%;
    width: clamp(11rem, 26vw, 24rem);
    aspect-ratio: 174 / 124;
    background-color: var(--accent-warm);
    -webkit-mask-image: var(--mark);
    mask-image: var(--mark);
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    -webkit-mask-size: contain;
    mask-size: contain;
    opacity: 0.8;
  }

  /* Langsames Schweben, wie im Entwurf. Nur mit ausdrücklich erlaubter
     Bewegung — die globale Regel in global.css schaltet Animationen bei
     prefers-reduced-motion ohnehin ab, hier zusätzlich explizit, damit
     die Absicht am Element steht. */
  @media (prefers-reduced-motion: no-preference) {
    .hero-mark {
      animation: float 9s var(--ease-in-out) infinite alternate;
    }

    @keyframes float {
      from {
        translate: 0 0.75rem;
      }
      to {
        translate: 0 -0.75rem;
      }
    }
  }

  /* Auf dem Telefon steht der Bogen unten rechts statt oben: Der
     Hero-Inhalt ist senkrecht zentriert, oben rechts lag der Bogen genau
     auf der Eyebrow-Zeile und der ersten Headline-Zeile. Unterhalb der
     Knöpfe ist Platz, und die Marke bleibt sichtbar. */
  @media (max-width: 48rem) {
    .hero-mark {
      top: auto;
      bottom: -4%;
      right: -20%;
      width: 13rem;
      opacity: 0.55;
    }
  }

  .hero-inner {
    max-width: var(--width-content);
    margin-inline: auto;
    padding: clamp(var(--sp-6), 9vw, var(--sp-7)) var(--sp-3);
    /* Untergrenze, keine Viewport-Höhe: der Hero darf wachsen, wenn der
       Anspruch umbricht, drückt den Rest der Seite aber auf kleinen
       Geräten nicht unter die Falz. */
    min-height: 30rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--sp-4);
  }

  @media (min-width: 48rem) {
    .hero-inner {
      min-height: 38rem;
    }
  }

  /* Mobil first (CLAUDE.md Regel 6), und zugleich die Rückkehr zu dem, was
     tokens.css seit August über diese eine Zeile sagt: "Der Anspruch im Hero
     bleibt bei --fs-xxl — dort steht die Wortmarke darüber und soll nicht
     überboten werden." Die Neugestaltung im September hatte --fs-display
     daraus gemacht, ohne den Kommentar anzufassen.

     Auf dem Telefon kostete das doppelt: 48 statt 39 px, und bei 390 px
     Breite zerfiel "Wir gründen eine Gemeinde" in drei Zeilen, von denen
     eine nur "eine" trug. Mit --fs-xxl stehen dort wieder zwei.

     --lh-tight statt des geerbten --lh-display: 1.02 lässt bei diesem Grad
     rund einen Pixel zwischen Unterlänge und Versalhöhe der nächsten Zeile.
     Das ist für ein- bis zweizeilige Schauzeilen gedacht; drei Zeilen daraus
     lesen sich als geschlossene Fläche. 1.15 ergibt sechs Pixel Luft. Der
     Token ist mit "h3/h4, Kacheltitel" beschrieben — hier trägt er
     zusätzlich die Hero-Zeile auf schmalen Schirmen, siehe DESIGN.md,
     "Der Hero war zu gedrungen". */
  .hero-claim {
    margin: 0;
    font-size: var(--fs-display);
    line-height: var(--lh-tight);
    max-width: 16ch;
  }

  /* Ab Tablet der Durchschuss der Schaustufe: Dort trägt die Zeile über
     100 px, und 1.15 risse den Block auseinander. Auf dem Telefon wäre
     derselbe Wert eine geschlossene Fläche — das war der Befund vom
     18. September nachmittags und er gilt unverändert. */
  @media (min-width: 48rem) {
    .hero-claim {
      line-height: var(--lh-display);
    }
  }

  .accent {
    display: block;
    color: var(--text-accent-on-dark);
  }

  .milestone-label {
    margin: 0;
    display: grid;
    gap: var(--sp-1);
  }

  .milestone-label .eyebrow {
    margin: 0;
    color: color-mix(in srgb, var(--text-on-dark) 70%, transparent);
  }

  .milestone-date {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--fs-l);
    letter-spacing: var(--tracking-tight);
  }

  .hero-actions {
    margin: var(--sp-2) 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-3);
  }

  /* Gruppierung auf dem Telefon. Gemessen stand hier 40 px zwischen
     Eyebrow und Überschrift, 24 px zwischen Überschrift und Terminlabel,
     32 px vor den Knöpfen — der größte Abstand also ausgerechnet zwischen
     der Eyebrow und der Zeile, zu der sie gehört, der kleinste zwischen
     zwei Blöcken, die nichts miteinander zu tun haben. Die Eyebrow stand
     dadurch als eigene erste Stufe frei, während Überschrift und Termin
     zu einer Masse verklebten.

     Die 40 px entstehen nicht durch eine Absicht, sondern durch Addition:
     der `gap` des Flex-Containers plus das globale `margin-bottom` von
     `.eyebrow` aus global.css. Beim Meilenstein-Label ist dieses Margin
     längst auf 0 überschrieben, oben war es vergessen.

     Jetzt aufsteigend: 8 / 24 / 32. Die Eyebrow sitzt als Dachzeile eng
     an der Überschrift, der Terminblock steht ab, die Knöpfe stehen
     weiter ab. Nur Abstands-Tokens, kein neuer Wert.

     Nur unter 48rem: Auf dem Desktop besteht dieselbe Inversion, fällt
     dort aber neben einer über 300 px hohen Überschrift nicht ins
     Gewicht — und die Desktop-Fassung ist ausdrücklich gelobt worden.
     Siehe DESIGN.md, „Der umgekehrte Rhythmus im Hero". */
  @media (max-width: 47.99rem) {
    .hero-inner {
      gap: var(--sp-2);
    }

    .hero-inner > .eyebrow {
      margin-bottom: 0;
    }

    .hero-claim {
      margin-bottom: var(--sp-3);
    }

    .milestone-label {
      margin-bottom: var(--sp-2);
    }

    .hero-actions {
      margin-top: var(--sp-3);
    }

    /* Gelbe Dachzeile — nur auf dem Telefon. Dort bricht die Zeile auf
       zwei Zeilen um und stünde in Weiß als zweiter Block neben der
       Überschrift; auf dem Desktop ist sie einzeilig und bleibt weiß, so
       ist sie ausdrücklich gewünscht.

       Dafür wird der oberste Stop von --scrim-hero von 58 auf 80 %
       verstärkt, und ausdrücklich NUR der oberste. Der Stop bei 45 %
       bleibt bei 78 %: Dort liegen die Giebel, und ein dunklerer Verlauf
       an dieser Stelle nimmt dem Foto die Farbe, ohne dem Text zu helfen.
       Gemessen bleibt die Bildhelligkeit auf Giebelhöhe bei 8–9, im
       obersten Streifen fällt sie von 25 auf 18 — dort ist fast nur
       Himmel.

