---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/Section.astro';

export async function getStaticPaths() {
  const elders = await getCollection('elders');
  return elders.map((elder) => ({
    params: { slug: elder.id },
    props: { elder },
  }));
}

const { elder } = Astro.props;
const { Content } = await render(elder);
---

<!-- Bewusst keine description: Es gibt kein geeignetes Frontmatter-Feld
     (der Markdown-Body ist die freie Profil-Prosa, keine Ein-Satz-Kurzform),
     und eines dafür anzulegen wäre eine Schema-Änderung für marginalen SEO-
     Gewinn. Google generiert stattdessen selbst einen Snippet aus dem
     Profiltext. -->
<BaseLayout title={elder.data.name}>
  <Section tone="light" width="measure">
    {
      elder.data.photo ? (
        <div class="profile-head">
          <Image
            src={elder.data.photo}
            alt=""
            width={288}
            densities={[1, 2]}
            format="webp"
            quality={90}
            class="photo"
          />
          <div>
            <h1>{elder.data.name}</h1>
            {elder.data.role && <p class="role">{elder.data.role}</p>}
          </div>
        </div>
      ) : (
        <>
          <h1>{elder.data.name}</h1>
          {elder.data.role && <p class="role">{elder.data.role}</p>}
        </>
      )
    }
    <div class="prose">
      <Content />
    </div>
  </Section>
</BaseLayout>

<style>
  .role {
    color: var(--text-secondary);
  }

  .profile-head {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-4);
    align-items: flex-start;
  }

  .profile-head h1 {
    margin-top: 0;
  }

  .photo {
    flex: 0 0 var(--size-portrait);
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: var(--radius-md) var(--radius-lg) var(--radius-md) var(--radius-md);
  }
</style>
