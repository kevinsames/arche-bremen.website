---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import Section from '../../components/Section.astro';

export async function getStaticPaths() {
  const elders = await getCollection('elders');
  return elders.map((elder) => ({
    params: { slug: elder.id },
    props: { elder },
  }));
}

const { elder } = Astro.props;
const { Content } = await render(elder);

// Meta-Description: der Anfang des ersten Absatzes, wörtlich — dieselbe
// Regel wie auf den Bekenntnisseiten (glaubensbekenntnis/[slug].astro),
// bewusst dort abgeschrieben statt in einen gemeinsamen Helfer gezogen
// (CLAUDE.md, harte Regel 2). Kein neues Frontmatter-Feld, keine eigene
// Zusammenfassung.
//
// Bis November 2026 hatten diese Seiten gar keine Description. Für Google
// ist der Unterschied klein, es nimmt sich sonst selbst einen Ausschnitt
// aus dem Profiltext. Der eigentliche Grund ist die Vorschau in WhatsApp
// und Signal: Ohne Description zeigt sie beim Teilen eines Profils nur den
// Namen, keinen Satz dazu.
const firstParagraph = (elder.body ?? '').trim().split(/\n\s*\n/)[0];
const plainText = firstParagraph
  .replace(/\[\^[^\]]+\]/g, '')
  .replace(/\*/g, '')
  .replace(/\s+/g, ' ')
  .trim();
const shortened = plainText.slice(0, plainText.lastIndexOf(' ', 154)).replace(/[,;:–—]+$/, '');
const description = plainText.length <= 155 ? plainText : `${shortened} …`;
---

<BaseLayout title={elder.data.name} description={description}>
  <PageHeader
    eyebrow={elder.data.role}
    title={elder.data.name}
    cloud={1}
    back={{ href: '/gemeindeleitung', label: 'Gemeindeleitung' }}
  />

  <Section tone="light" width="measure">
    {
      elder.data.photo && (
        <Image
          src={elder.data.photo}
          alt=""
          width={288}
          densities={[1, 2]}
          format="webp"
          quality={90}
          class="photo"
        />
      )
    }
    <div class="prose">
      <Content />
    </div>
    {
      elder.data.familyPhoto && (
        <Image
          src={elder.data.familyPhoto}
          alt={`${elder.data.name} mit seiner Familie`}
          width={640}
          densities={[1, 2]}
          format="webp"
          quality={85}
          class="family-photo"
        />
      )
    }
  </Section>
</BaseLayout>

<style>
  /* Radius und Schatten wie die Kacheln (--radius-lg, --shadow-card): Das
     Porträt steht hier allein auf weißem Grund und wirkte mit dem
     kleineren Radius wie ein Rest der alten Seite. */
  .photo {
    width: min(100%, var(--size-portrait));
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-card);
    margin-bottom: var(--sp-5);
  }

  /* Kein aspect-ratio/object-fit wie bei .photo: Das Familienfoto steht in
     seinem eigenen Seitenverhältnis, unbeschnitten. */
  .family-photo {
    width: 100%;
    height: auto;
    margin-top: var(--sp-6);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-card);
  }
</style>
