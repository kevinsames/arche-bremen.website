---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import Section from '../../components/Section.astro';
import ElderCard from '../../components/ElderCard.astro';
import Slider from '../../components/Slider.astro';

const elders = (await getCollection('elders')).sort((a, b) => {
  const aIsPastor = a.data.role === 'Pastor';
  const bIsPastor = b.data.role === 'Pastor';
  if (aIsPastor !== bIsPastor) return aIsPastor ? -1 : 1;
  return a.data.name.localeCompare(b.data.name, 'de');
});
---

<BaseLayout
  title="Gemeindeleitung"
  description="Die Gemeindeleitung der Arche Bremen: Wer die Gemeindegründung in Bremen leitet und wofür sie verantwortlich ist."
>
  {/* Vers zitiert nach Elberfelder Bibel (2006); die Quellenzeile nennt
      bewusst nur „Die Bibel" (DESIGN.md, „Bibelvers auf dunklem Grund"). */}
  <PageHeader
    eyebrow="Verantwortung für Lehre und Leben der Gemeinde"
    title="Gemeindeleitung"
    cloud={3}
    verse={{
      text: 'So, in Liebe zu euch hingezogen, waren wir willig, euch nicht allein am Evangelium Gottes, sondern auch an unserem eigenen Leben Anteil zu geben, weil ihr uns lieb geworden wart.',
      reference: '1. Thessalonicher 2,8',
    }}
  />

  <Section tone="light">
    {
      elders.length === 0 ? (
        <p>Noch keine Profile hinterlegt.</p>
      ) : (
        <Slider label="Gemeindeleitung">
          {elders.map((elder, index) => (
            <ElderCard elder={elder} index={index} />
          ))}
        </Slider>
      )
    }
  </Section>
</BaseLayout>
