---
import { render, type CollectionEntry } from 'astro:content';
import Overlay from './Overlay.astro';

// Kachel für einen Artikel des Glaubensbekenntnisses, gleiche Bauweise wie
// SermonCard/ElderCard: Anker (Tastatur-Weg zur Detailseite) und
// deckungsgleicher Button (Maus/Touch, öffnet das Popup mit dem gerenderten
// Markdown-Body). Details siehe Kommentar in SermonCard.astro.
//
// Anders als dort: keine Flächenrotation. Bei 25 Kacheln wirken drei
// wechselnde Töne unruhig, ohne dass die Farbe etwas bedeutet — ein Ton
// genügt.
interface Props {
  article: CollectionEntry<'creed'>;
  index?: number;
}

const { article, index = 0 } = Astro.props;
const { Content } = await render(article);

const overlayId = `creed-${article.id}`;
const permalink = `/glaubensbekenntnis/${article.id}`;
---

<div class="card-wrap"
     style={`--cloud: var(--cloud-${(index % 4) + 1}); --reveal-offset: ${(index % 3) * 4}%`}
     data-reveal>
  <a href={permalink} class="card">
    <span class="cloud" aria-hidden="true"></span>
    <span class="body">
      <span class="top">
        <span class="number">Artikel {article.data.number}</span>
        <span class="plus" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <path d="M12 5v14M5 12h14" />
          </svg>
        </span>
      </span>
      <span class="title">{article.data.title}</span>
    </span>
  </a>
  <button
    type="button"
    popovertarget={overlayId}
    class="open"
    tabindex="-1"
    aria-label={`Artikel öffnen: ${article.data.title}`}
  >
  </button>
</div>

<Overlay id={overlayId} label={article.data.title} cloud={(index % 4) + 1}>
  <Fragment slot="head">
    <span class="kicker">Artikel {article.data.number}</span>
    <h2>{article.data.title}</h2>
  </Fragment>
  <div class="prose">
    <Content />
  </div>
  <p class="overlay-link"><a href={permalink}>Zum Artikel &rarr;</a></p>
</Overlay>

<style>
  .card-wrap {
    position: relative;
  }

  /* Gleiches Kachelmuster wie MinistryCard.astro, aber bewusst OHNE
     aspect-ratio: 4/5. Bei 25 Artikeln ergäbe das Hochformat eine Seite
     von mehreren Bildschirmhöhen, durch die niemand scrollt. Stattdessen
     eine Mindesthöhe — die Kachel bleibt kompakt und wächst nur, wenn ein
     Titel umbricht. */
  .card {
    position: relative;
    display: block;
    min-height: 11rem;
    border-radius: var(--radius-lg);
    overflow: clip;
    background-color: var(--bg-inverted);
    color: var(--text-on-dark);
    box-shadow: var(--shadow-card);
    text-decoration: none;
    transition:
      translate var(--duration-slow) var(--ease-out),
      box-shadow var(--duration-slow) var(--ease-out);
  }

  .card:visited {
    color: var(--text-on-dark);
  }

  .card-wrap:has(.open:hover) .card,
  .card:focus-visible {
    translate: 0 -6px;
    box-shadow: var(--shadow-card-hover);
  }

  .cloud {
    position: absolute;
    /* Deutlich größer als die Kachel: Weg (6 %) und Drehung (4°) dürfen
       keine Kante ins Bild holen. */
    inset: -26%;
    background-image: var(--cloud);
    transition: scale var(--duration-slow) var(--ease-out);
  }

  /* Die Farbwolke wandert sehr langsam, damit die Kachel eine Fläche mit
     Leben ist und kein Standbild. Bewegt wird `translate` (nicht
     `background-position`): Das läuft auf dem Compositor und kostet keine
     Neuzeichnung pro Bild — bei acht Kacheln auf einem Telefon der
     Unterschied zwischen flüssig und ruckelig. Deshalb ist die Wolke auch
     größer als die Kachel (inset: -12%), sonst liefe beim Wandern eine
     Kante ins Bild.

     `scale` bleibt dabei frei für den Hover-Zustand — Animation und
     Transition fassen verschiedene Eigenschaften an und geraten sich
     nicht in die Quere. */
  @media (prefers-reduced-motion: no-preference) {
    .cloud {
      animation: cloud-drift 14s var(--ease-in-out) infinite alternate;
    }

    /* Verschieben UND drehen. Nur zu verschieben reicht nicht: Die
       Farbflecken bewegen sich dabei alle gleich, das Auge liest es als
       Stillstand. Mit der Drehung wandern sie gegeneinander, und die
       Fläche wirkt in Bewegung. `scale` bleibt bewusst unangetastet —
       das gehört dem Hover-Zustand. */
    @keyframes cloud-drift {
      from {
        translate: -6% -4%;
        rotate: -10deg;
      }
      to {
        translate: 6% 4%;
        rotate: 10deg;
      }
    }
  }


  .card-wrap:has(.open:hover) .cloud,
  .card:focus-visible .cloud {
    scale: 1.06;
  }

  .body {
    position: relative;
    display: grid;
    /* minmax(0, 1fr) statt der impliziten Spalte: Grid-Items haben
       min-width: auto und wachsen sonst über die Kachel hinaus, sobald ein
       langes Wort wie „Sonntagsgottesdienste" nicht in die Zeile passt —
       overflow-wrap greift dann nie, weil es gar keine zu enge Zeile gibt.
       Sichtbar wurde das als abgeschnittener Titel und verschobenem
       Plus-Kreis. */
    grid-template-columns: minmax(0, 1fr);
    align-content: space-between;
    gap: var(--sp-4);
    min-height: 11rem;
    padding: var(--sp-4);
    background-image: var(--scrim-card);
  }

  .top {
    min-width: 0;
    display: flex;
    align-items: start;
    justify-content: space-between;
    gap: var(--sp-3);
  }

  .number,
  .plus {
    background-color: color-mix(in srgb, var(--text-on-dark) 14%, transparent);
    border: 1px solid color-mix(in srgb, var(--text-on-dark) 28%, transparent);
    border-radius: var(--radius-pill);
    -webkit-backdrop-filter: blur(var(--blur-glass));
    backdrop-filter: blur(var(--blur-glass));
  }

  .number {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--fs-xs);
    letter-spacing: var(--tracking-label);
    line-height: 1;
    text-transform: uppercase;
    padding: var(--sp-2) var(--sp-3);
  }

  .plus {
    flex-shrink: 0;
    margin-left: auto;
    display: grid;
    place-items: center;
    width: 2.375rem;
    height: 2.375rem;
    transition: rotate var(--duration-slow) var(--ease-out);
  }

  .plus svg {
    width: 1.1rem;
    height: 1.1rem;
  }

  .card-wrap:has(.open:hover) .plus,
  .card:focus-visible .plus {
    rotate: 90deg;
  }

  .card-wrap:has(.open:hover) .title,
  .card:focus-visible .title {
    translate: 0 -4px;
  }

  .title {
    display: block;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--fs-l);
    line-height: var(--lh-tight);
    letter-spacing: var(--tracking-tight);
    -webkit-hyphens: auto;
    hyphens: auto;
    overflow-wrap: break-word;
  }

  .open {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    padding: 0;
    margin: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
  }

  @supports not selector(:popover-open) {
    .open {
      display: none;
    }
  }

  .overlay-link {
    margin: var(--sp-4) 0 0;
  }
</style>
