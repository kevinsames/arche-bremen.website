---
import { render, type CollectionEntry } from 'astro:content';
import Overlay from './Overlay.astro';

// Kachel für einen Artikel des Glaubensbekenntnisses, gleiche Bauweise wie
// SermonCard/ElderCard: Anker (Tastatur-Weg zur Detailseite) und
// deckungsgleicher Button (Maus/Touch, öffnet das Popup mit dem gerenderten
// Markdown-Body). Details siehe Kommentar in SermonCard.astro.
//
// Anders als dort: keine Flächenrotation. Bei 25 Kacheln wirken drei
// wechselnde Töne unruhig, ohne dass die Farbe etwas bedeutet — ein Ton
// genügt. Stattdessen trägt die Kachel einen zusammenfassenden Satz
// (article.data.summary), damit sich der Inhalt ohne Klick erschließt.
interface Props {
  article: CollectionEntry<'creed'>;
}

const { article } = Astro.props;
const { Content } = await render(article);

const overlayId = `creed-${article.id}`;
const permalink = `/glaubensbekenntnis/${article.id}`;
---

<div class="card-wrap">
  <a href={permalink} class="card">
    <span class="number">Artikel {article.data.number}</span>
    <p class="title">{article.data.title}</p>
    {article.data.summary && <p class="summary">{article.data.summary}</p>}
    <span class="chevron" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
           stroke-linecap="round" stroke-linejoin="round">
        <path d="M9 6l6 6-6 6" />
      </svg>
    </span>
  </a>
  <button
    type="button"
    popovertarget={overlayId}
    class="open"
    tabindex="-1"
    aria-label={`Artikel öffnen: ${article.data.title}`}
  >
  </button>
</div>

<Overlay id={overlayId} label={article.data.title}>
  <p class="overlay-number">Artikel {article.data.number}</p>
  <h2 class="overlay-title">{article.data.title}</h2>
  <div class="prose">
    <Content />
  </div>
  <p><a href={permalink}>Zum Artikel &rarr;</a></p>
</Overlay>

<style>
  .card-wrap {
    position: relative;
  }

  .card {
    position: relative;
    display: block;
    text-decoration: none;
    color: var(--text-primary);
    padding: var(--sp-4) var(--sp-3) var(--sp-5);
    border-radius: var(--radius-md);
    background-color: var(--surface-warm);
    transition:
      translate var(--duration-fast) var(--ease-out),
      background-color var(--duration-fast) var(--ease-out);
  }

  .card-wrap:has(.open:hover) .card,
  .card:focus-visible {
    background-color: var(--surface-warm-strong);
    translate: 0 -2px;
  }

  .card-wrap:has(.open:hover) .title,
  .card:focus-visible .title {
    text-decoration: underline;
  }

  /* Dauerhaft sichtbar (nicht erst bei Hover) — auf Touch gibt es keinen
     Hover, ohne dieses Icon wäre die Klickbarkeit dort unsichtbar. */
  .chevron {
    position: absolute;
    right: var(--sp-3);
    bottom: var(--sp-3);
    width: 1em;
    color: var(--text-secondary);
    transition: translate var(--duration-fast) var(--ease-out);
  }

  .card-wrap:has(.open:hover) .chevron,
  .card:focus-visible .chevron {
    translate: 2px 0;
  }

  .card:visited {
    color: var(--text-primary);
  }

  .number {
    display: block;
    font-family: var(--font-display);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: var(--tracking-display);
    font-size: var(--fs-xs);
    color: var(--text-secondary);
  }

  .title {
    font-family: var(--font-display);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: var(--tracking-display);
    font-size: var(--fs-m);
    margin: var(--sp-1) 0 0;
  }

  .summary {
    font-size: var(--fs-s);
    line-height: var(--lh-body);
    color: var(--text-secondary);
    margin: var(--sp-2) 0 0;
  }

  .open {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    padding: 0;
    margin: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
  }

  @supports not selector(:popover-open) {
    .open {
      display: none;
    }
  }

  .overlay-number {
    color: var(--text-secondary);
    font-size: var(--fs-xs);
    margin: 0;
  }

  .overlay-title {
    margin: var(--sp-1) 0 0;
  }
</style>
