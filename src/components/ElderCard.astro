---
import { render, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Overlay from './Overlay.astro';

// Kachel für ein Ältesten-Profil auf /gemeindeleitung, gleiche Bauweise wie
// SermonCard: Anker (Tastatur-Weg zur Detailseite) und deckungsgleicher
// Button (Maus/Touch, öffnet das Popup mit dem gerenderten Markdown-Body).
// Details siehe Kommentar in SermonCard.astro.
interface Props {
  elder: CollectionEntry<'elders'>;
}

const { elder } = Astro.props;
const { Content } = await render(elder);

const overlayId = `elder-${elder.id}`;
const permalink = `/gemeindeleitung/${elder.id}`;
---

<div class="card-wrap">
  <a href={permalink} class="card">
    {elder.data.photo && (
      // alt="": Der Name steht als Text unmittelbar darunter, ein
      // Alt-Text wäre für Screenreader nur eine Dopplung.
      <Image
        src={elder.data.photo}
        alt=""
        width={288}
        densities={[1, 2]}
        format="webp"
        quality={90}
        class="photo"
      />
    )}
    <div class="card-text">
      <p class="name">{elder.data.name}</p>
      {elder.data.role && <p class="role">{elder.data.role}</p>}
      <span class="chevron" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
             stroke-linecap="round" stroke-linejoin="round">
          <path d="M9 6l6 6-6 6" />
        </svg>
      </span>
    </div>
  </a>
  <button
    type="button"
    popovertarget={overlayId}
    class="open"
    tabindex="-1"
    aria-label={`Profil öffnen: ${elder.data.name}`}
  >
  </button>
</div>

<Overlay id={overlayId} label={elder.data.name}>
  <h2 class="overlay-name">{elder.data.name}</h2>
  {elder.data.role && <p class="overlay-role">{elder.data.role}</p>}
  <div class="prose">
    <Content />
  </div>
  <p><a href={permalink}>Zum Profil &rarr;</a></p>
</Overlay>

<style>
  .card-wrap {
    position: relative;
  }

  .card {
    display: block;
    text-decoration: none;
    color: var(--text-primary);
    padding: 0;
    overflow: hidden;
    border-radius: var(--radius-md);
    background-color: var(--surface-warm);
    transition:
      translate var(--duration-fast) var(--ease-out),
      background-color var(--duration-fast) var(--ease-out);
  }

  .card-text {
    position: relative;
    padding: var(--sp-4) var(--sp-3) var(--sp-5);
  }

  .photo {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }

  .card-wrap:has(.open:hover) .card,
  .card:focus-visible {
    background-color: var(--surface-warm-strong);
    translate: 0 -2px;
  }

  .card-wrap:has(.open:hover) .name,
  .card:focus-visible .name {
    text-decoration: underline;
  }

  /* Dauerhaft sichtbar (nicht erst bei Hover) — auf Touch gibt es keinen
     Hover, ohne dieses Icon wäre die Klickbarkeit dort unsichtbar. */
  .chevron {
    position: absolute;
    right: var(--sp-3);
    bottom: var(--sp-3);
    width: 1em;
    color: var(--text-secondary);
    transition: translate var(--duration-fast) var(--ease-out);
  }

  .card-wrap:has(.open:hover) .chevron,
  .card:focus-visible .chevron {
    translate: 2px 0;
  }

  .card:visited {
    color: var(--text-primary);
  }

  .name {
    font-family: var(--font-display);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: var(--tracking-display);
    font-size: var(--fs-m);
    margin: 0;
  }

  .role {
    color: var(--text-secondary);
    font-size: var(--fs-xs);
    margin: var(--sp-1) 0 0;
  }

  .open {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    padding: 0;
    margin: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
  }

  @supports not selector(:popover-open) {
    .open {
      display: none;
    }
  }

  .overlay-name {
    margin: 0;
  }

  .overlay-role {
    color: var(--text-secondary);
    margin: var(--sp-1) 0 0;
  }
</style>
