---
import { render, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Overlay from './Overlay.astro';

// Kachel für ein Ältesten-Profil auf /gemeindeleitung. Gleiche Bauweise wie
// SermonCard: Anker (Tastatur-Weg zur Detailseite) und deckungsgleicher
// Button (Maus/Touch, öffnet das Popup mit dem gerenderten Markdown-Body).
//
// Anders als die übrigen Kacheln (Gemeindeleben, Predigten, Glaubens-
// bekenntnis) steht hier ein echtes Foto und keine Farbwolke, und Name und
// Rolle stehen UNTER dem Bild statt darüber: Ein Verlauf über dem Gesicht
// würde das Porträt beschädigen. Unten rechts auf dem Foto steht dauerhaft
// derselbe Plus-Kreis wie auf den übrigen Kacheln — auf dem Telefon das
// einzige Zeichen, dass sich hinter dem Porträt mehr verbirgt. Beim
// Überfahren zoomt das Bild leicht, der Plus-Kreis tritt zurück und ein
// „Mehr lesen"-Pill blendet sich unten links ein.
interface Props {
  elder: CollectionEntry<'elders'>;
  index?: number;
}

const { elder, index = 0 } = Astro.props;
const { Content } = await render(elder);

const overlayId = `elder-${elder.id}`;
const permalink = `/gemeindeleitung/${elder.id}`;
---

<div
  class="card-wrap"
  style={`--cloud: var(--cloud-${(index % 4) + 1}); --reveal-offset: ${(index % 3) * 4}%`}
  data-reveal
>
  <a href={permalink} class="card">
    <span class:list={['frame', !elder.data.photo && 'frame--cloud']}>
      {elder.data.photo && (
        // alt="": Der Name steht als Text unmittelbar darunter, ein
        // Alt-Text wäre für Screenreader nur eine Dopplung.
        <Image
          src={elder.data.photo}
          alt=""
          width={288}
          densities={[1, 2]}
          format="webp"
          quality={90}
          class="photo"
        />
      )}
      <span class="hint" aria-hidden="true">Mehr lesen &rarr;</span>
      <span class="plus" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <path d="M12 5v14M5 12h14" />
        </svg>
      </span>
    </span>
    <span class="text">
      <span class="name">{elder.data.name}</span>
      {elder.data.role && <span class="role">{elder.data.role}</span>}
    </span>
  </a>
  <button
    type="button"
    popovertarget={overlayId}
    class="open"
    tabindex="-1"
    aria-label={`Profil öffnen: ${elder.data.name}`}
  >
  </button>
</div>

<Overlay id={overlayId} label={elder.data.name} cloud={(index % 4) + 1}>
  <Fragment slot="head">
    {elder.data.role && <span class="kicker">{elder.data.role}</span>}
    <h2>{elder.data.name}</h2>
  </Fragment>
  <div class="prose">
    <Content />
  </div>
  <p class="overlay-link"><a href={permalink}>Zum Profil &rarr;</a></p>
</Overlay>

<style>
  .card-wrap {
    position: relative;
  }

  .card {
    display: grid;
    gap: var(--sp-3);
    text-decoration: none;
    color: var(--text-primary);
  }

  .card:visited {
    color: var(--text-primary);
  }

  .frame {
    position: relative;
    display: block;
    aspect-ratio: 4 / 5;
    border-radius: var(--radius-lg);
    overflow: clip;
    background-color: var(--bg-muted);
    box-shadow: var(--shadow-card);
    transition: box-shadow var(--duration-slow) var(--ease-out);
  }

  /* `photo` ist im Schema optional. Ohne Foto blieb hier eine leere graue
     Fläche im Seitenverhältnis 4:5 stehen — schlechter als gar keine
     Kachel. Stattdessen die Farbwolke der übrigen Kacheltypen: kein
     Platzhalterfoto, keine Silhouette (CLAUDE.md Design-Regel 9), sondern
     dieselbe abstrakte Fläche, die Gemeindeleben und Predigten tragen. */
  .frame--cloud {
    background-color: var(--bg-inverted);
    background-image: var(--cloud);
  }

  .photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: scale var(--duration-slow) var(--ease-out);
  }

  .card-wrap:has(.open:hover) .photo,
  .card:focus-visible .photo {
    scale: 1.05;
  }

  .card-wrap:has(.open:hover) .frame,
  .card:focus-visible .frame {
    box-shadow: var(--shadow-card-hover);
  }

  /* Der Pill an der Unterkante erscheint erst beim Überfahren. Auf Touch
     gibt es keinen Hover — dort trägt der Plus-Kreis (unten) allein das
     Signal. Name und Rolle unter dem Foto reichten dafür nicht: Die
     Gemeindeleitung hat im Oktober 2026 berichtet, dass die Kachel auf
     dem Telefon nicht als antippbar erkannt wurde. */
  .hint {
    position: absolute;
    left: var(--sp-3);
    bottom: var(--sp-3);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--fs-xs);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    line-height: 1;
    padding: var(--sp-2) var(--sp-3);
    border-radius: var(--radius-pill);
    background-color: var(--bg-inverted);
    color: var(--text-on-dark);
    opacity: 0;
    translate: 0 8px;
    transition:
      opacity var(--duration-slow) var(--ease-out),
      translate var(--duration-slow) var(--ease-out);
  }

  .card-wrap:has(.open:hover) .hint,
  .card:focus-visible .hint {
    opacity: 1;
    translate: 0 0;
  }

  /* Dauerhaft sichtbar, anders als der Pill. Unten rechts statt oben
     rechts wie bei Predigten und Gemeindeleben: Im 4:5-Porträt sitzt das
     Gesicht im oberen Drittel, die untere Ecke ist meist Schulter oder
     Hintergrund. Volle Fläche in --bg-inverted statt der Glasfläche der
     übrigen Kacheln — die ist auf einen dunklen Farbverlauf gerechnet und
     verschwände auf einem hellen Fotohintergrund. Beim Überfahren tritt
     der Kreis zurück, damit nicht zwei Hinweise zugleich stehen. */
  .plus {
    position: absolute;
    right: var(--sp-3);
    bottom: var(--sp-3);
    display: grid;
    place-items: center;
    width: 2.375rem;
    height: 2.375rem;
    border-radius: var(--radius-pill);
    background-color: var(--bg-inverted);
    color: var(--text-on-dark);
    transition:
      opacity var(--duration-slow) var(--ease-out),
      rotate var(--duration-slow) var(--ease-out);
  }

  .plus svg {
    width: 1.1rem;
    height: 1.1rem;
  }

  .card-wrap:has(.open:hover) .plus,
  .card:focus-visible .plus {
    opacity: 0;
    rotate: 90deg;
  }

  .text {
    display: grid;
    gap: var(--sp-1);
  }

  .name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--fs-l);
    line-height: var(--lh-tight);
    letter-spacing: var(--tracking-tight);
  }

  .role {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--fs-xs);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    /* Der Entwurf setzt die Rolle in Blau (--c-blue). Hier bewusst nicht:
       --c-blue erreicht auf Weiß 3.96 : 1 und ist laut tokens.css nur für
       große Schrift und UI-Rahmen zugelassen — dieses Label ist --fs-xs
       und verfehlte damit AA. --text-secondary trägt mit 6.15 : 1. */
    color: var(--text-secondary);
  }

  .open {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    padding: 0;
    margin: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
  }

  @supports not selector(:popover-open) {
    .open {
      display: none;
    }
  }

  /* Nach dem Schließen setzt der Browser den Fokus auf den Auslöser
     zurück — das ist dieser Knopf. Ein Ring kann hier nie aus der
     Tastaturnavigation stammen: tabindex="-1" (siehe Markup) nimmt ihn
     aus der Tab-Reihenfolge, der Tastaturweg führt über den Anker
     darunter, der seinen Ring behält. Sichtbar war der Ring nur auf
     iOS Safari, dessen Heuristik den zurückgesetzten Fokus als
     „sichtbar" wertet — und zwar als eckiges Rechteck um die runde
     Kachel. Beide Zustände abgedeckt, weil Safari den Ring teils schon
     an :focus hängt, nicht erst an :focus-visible. */
  .open:focus,
  .open:focus-visible {
    outline: none;
  }


  .overlay-link {
    margin: var(--sp-4) 0 0;
  }
</style>
