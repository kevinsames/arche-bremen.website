---
import { render, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Overlay from './Overlay.astro';

// Kachel für ein Ältesten-Profil auf /aelteste, gleiche Bauweise wie
// SermonCard: Anker (Tastatur-Weg zur Detailseite) und deckungsgleicher
// Button (Maus/Touch, öffnet das Popup mit dem gerenderten Markdown-Body).
// Details siehe Kommentar in SermonCard.astro. Die Flächenrotation über
// den Index ist ebenfalls von dort übernommen.
interface Props {
  elder: CollectionEntry<'elders'>;
  index: number;
}

const { elder, index } = Astro.props;
const { Content } = await render(elder);

const surfaces = [
  ['--surface-warm', '--surface-warm-strong'],
  ['--surface-warm-alt', '--surface-warm-alt-strong'],
  ['--surface-nature', '--surface-nature-strong'],
] as const;
const [surface, surfaceHover] = surfaces[index % surfaces.length];

const overlayId = `elder-${elder.id}`;
const permalink = `/aelteste/${elder.id}`;
---

<div class="card-wrap">
  <a
    href={permalink}
    class="card"
    style={`--card-surface: var(${surface}); --card-surface-hover: var(${surfaceHover})`}
  >
    {elder.data.photo && (
      // alt="": Der Name steht als Text unmittelbar darunter, ein
      // Alt-Text wäre für Screenreader nur eine Dopplung.
      <Image
        src={elder.data.photo}
        alt=""
        width={288}
        densities={[1, 2]}
        format="webp"
        quality={90}
        class="photo"
      />
    )}
    <div class="card-text">
      <p class="name">{elder.data.name}</p>
      {elder.data.role && <p class="role">{elder.data.role}</p>}
    </div>
  </a>
  <button
    type="button"
    popovertarget={overlayId}
    class="open"
    tabindex="-1"
    aria-label={`Profil öffnen: ${elder.data.name}`}
  >
  </button>
</div>

<Overlay id={overlayId} label={elder.data.name}>
  <h2 class="overlay-name">{elder.data.name}</h2>
  {elder.data.role && <p class="overlay-role">{elder.data.role}</p>}
  <div class="prose">
    <Content />
  </div>
  <p><a href={permalink}>Zum Profil &rarr;</a></p>
</Overlay>

<style>
  .card-wrap {
    position: relative;
  }

  .card {
    display: block;
    text-decoration: none;
    color: var(--text-primary);
    padding: 0;
    overflow: hidden;
    border-radius: var(--radius-md) var(--radius-lg) var(--radius-md) var(--radius-md);
    background-color: var(--card-surface);
    transition:
      translate var(--duration-fast) var(--ease-out),
      background-color var(--duration-fast) var(--ease-out);
  }

  .card-text {
    padding: var(--sp-4) var(--sp-3);
  }

  .photo {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }

  .card-wrap:has(.open:hover) .card,
  .card:focus-visible {
    background-color: var(--card-surface-hover);
    translate: 0 -2px;
  }

  .card-wrap:has(.open:hover) .name,
  .card:focus-visible .name {
    text-decoration: underline;
  }

  .card:visited {
    color: var(--text-primary);
  }

  .name {
    font-family: var(--font-display);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: var(--tracking-display);
    font-size: var(--fs-m);
    margin: 0;
  }

  .role {
    color: var(--text-secondary);
    font-size: var(--fs-xs);
    margin: var(--sp-1) 0 0;
  }

  .open {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    padding: 0;
    margin: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
  }

  @supports not selector(:popover-open) {
    .open {
      display: none;
    }
  }

  .overlay-name {
    margin: 0;
  }

  .overlay-role {
    color: var(--text-secondary);
    margin: var(--sp-1) 0 0;
  }
</style>
