---
import { render, type CollectionEntry } from 'astro:content';
import Overlay from './Overlay.astro';

// Kachel für einen Bereich des Gemeindelebens, gleiche Bauweise wie
// CreedCard/ElderCard/SermonCard (siehe dortiger Kommentar). Ein
// Unterschied: CreedCard verlinkt zusätzlich zu einer Detailseite (Anker
// plus deckungsgleicher Button, siehe dort) — für Gemeindeleben gibt es
// keine Detailseiten, deshalb ist die Kachel hier ein einzelner
// <button popovertarget>, ohne begleitenden Anker.
//
// Bekannte Einschränkung: Browser ohne Popover-Unterstützung blenden jedes
// [popover] dauerhaft aus (siehe global.css) — ohne Detailseite als
// Rückfall bleibt dort nur `summary` sichtbar, nicht der volle Body-Text.
// Deshalb ist `summary` im Schema (content.config.ts) ein Pflichtfeld.
interface Props {
  ministry: CollectionEntry<'ministries'>;
}

const { ministry } = Astro.props;
const { Content } = await render(ministry);

const overlayId = `ministry-${ministry.id}`;
---

<button
  type="button"
  popovertarget={overlayId}
  class="card"
  aria-label={`Mehr erfahren: ${ministry.data.title}`}
>
  {ministry.data.status && <span class="status">{ministry.data.status}</span>}
  <p class="title">{ministry.data.title}</p>
  <p class="summary">{ministry.data.summary}</p>
  <span class="chevron" aria-hidden="true">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
         stroke-linecap="round" stroke-linejoin="round">
      <path d="M9 6l6 6-6 6" />
    </svg>
  </span>
</button>

<Overlay id={overlayId} label={ministry.data.title}>
  {ministry.data.status && <p class="overlay-status">{ministry.data.status}</p>}
  <h2 class="overlay-title">{ministry.data.title}</h2>
  <div class="prose">
    <Content />
  </div>
</Overlay>

<style>
  .card {
    position: relative;
    display: block;
    width: 100%;
    text-align: left;
    text-decoration: none;
    color: var(--text-primary);
    padding: var(--sp-4) var(--sp-3) var(--sp-5);
    margin: 0;
    border: 0;
    border-radius: var(--radius-md);
    background-color: var(--surface-warm);
    font: inherit;
    cursor: pointer;
    transition:
      translate var(--duration-fast) var(--ease-out),
      background-color var(--duration-fast) var(--ease-out);
  }

  .card:hover,
  .card:focus-visible {
    background-color: var(--surface-warm-strong);
    translate: 0 -2px;
  }

  .card:hover .title,
  .card:focus-visible .title {
    text-decoration: underline;
  }

  .status {
    display: block;
    font-family: var(--font-display);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: var(--tracking-display);
    font-size: var(--fs-xs);
    color: var(--text-secondary);
  }

  .title {
    font-family: var(--font-display);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: var(--tracking-display);
    font-size: var(--fs-m);
    margin: var(--sp-1) 0 0;
  }

  .summary {
    font-size: var(--fs-s);
    line-height: var(--lh-body);
    color: var(--text-secondary);
    margin: var(--sp-2) 0 0;
  }

  /* Dauerhaft sichtbar (nicht erst bei Hover) — auf Touch gibt es keinen
     Hover, ohne dieses Icon wäre die Klickbarkeit sonst unsichtbar. */
  .chevron {
    position: absolute;
    right: var(--sp-3);
    bottom: var(--sp-3);
    width: 1em;
    color: var(--text-secondary);
    transition: translate var(--duration-fast) var(--ease-out);
  }

  .card:hover .chevron,
  .card:focus-visible .chevron {
    translate: 2px 0;
  }

  .overlay-status {
    color: var(--text-secondary);
    font-size: var(--fs-xs);
    margin: 0;
  }

  .overlay-title {
    margin: var(--sp-1) 0 0;
  }
</style>
