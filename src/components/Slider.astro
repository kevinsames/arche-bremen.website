---
// Horizontale, wischbare Kachel-Reihe (Apple-Muster) für Startseite und
// /aelteste. Reines CSS: scroll-snap für das Wischen, kein JavaScript,
// keine Pfeil-Buttons. Für lange Listen (z.B. das Predigt-Archiv)
// ungeeignet, dafür bleibt /predigten ein normales Raster.
---

<div class="slider">
  <slot />
</div>

<style>
  /* Randabfluss bis zur Viewport-Kante: Section gibt --sp-3 Innenabstand
     vor (siehe Section.astro), hier per negativem margin-inline
     aufgehoben und als padding-inline zurückgegeben — so beginnt die
     erste Kachel bündig mit der Überschrift und die letzte läuft am
     Rand aus. scroll-padding-inline hält den Snap-Punkt am selben Rand. */
  .slider {
    display: flex;
    gap: var(--sp-3);
    margin: var(--sp-4) calc(var(--sp-3) * -1) 0;
    padding: 0 var(--sp-3) var(--sp-2);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--sp-3);
  }

  .slider > :global(*) {
    flex: 0 0 16rem;
    scroll-snap-align: start;
  }

  @media (min-width: 40rem) {
    .slider > :global(*) {
      flex: 0 0 18rem;
    }
  }
</style>
