---
import type { Sermon } from '../lib/sanity';
import type { CollectionEntry } from 'astro:content';
import { formatPassages } from '../lib/bible';
import { normalizeSearch } from '../lib/search';
import Overlay from './Overlay.astro';
import SermonDetail from './SermonDetail.astro';

// Kachel für eine Predigt, genutzt auf der Startseite und der
// Predigtübersicht. Ohne Foto (siehe CLAUDE.md — keine Stock-Fotografie,
// echte Gemeindefotos gibt es noch nicht): die ganze Kachelfläche trägt
// eine von drei stark verdünnten Akzentfarben (siehe tokens.css,
// --surface-*), die Bibelstelle steht als Eyebrow über dem Titel.
//
// Ein Klick öffnet den Inhalt als Popup (siehe Overlay.astro) statt einer
// neuen Seite. Die Kachel bleibt zusätzlich ein echter Link zur
// Detailseite (predigten/[slug].astro) — das hält den Permalink crawlbar
// und ist der Rückfall für Browser ohne Popover-Unterstützung (siehe
// @supports-Block unten).
//
// Zwei übereinanderliegende Elemente: der Anker (normal fokussierbar,
// Tastatur-Weg zur Detailseite) und der deckungsgleiche Button
// (tabindex="-1", nur per Maus/Touch erreichbar, öffnet das Popup). Ein
// Element könnte nicht beides — <a popovertarget> wird vom Browser
// ignoriert, das Attribut funktioniert nur auf <button>.
//
// preacherProfile: gesetzt, wenn ein passendes Repo-Profil existiert
// (siehe predigten/index.astro für die Verknüpfungslogik).
interface Props {
  sermon: Sermon;
  index: number;
  preacherProfile?: CollectionEntry<'elders'>;
}

const { sermon, index, preacherProfile } = Astro.props;

const dateFormatter = new Intl.DateTimeFormat('de-DE', { dateStyle: 'long' });
const overlayId = `sermon-${sermon.slug}`;
const permalink = `/predigten/${sermon.slug}`;

// Filterdaten für SermonFilter.astro (siehe dort). Auf Seiten ohne Filter
// (Startseite, Slider) bleiben diese Attribute schlicht ungenutzt.
//
// searchIndex deckt Titel, Prediger, Reihe, Bibelstelle (deutsch und als
// ASCII-Buchschlüssel, siehe bible.ts) und Beschreibung ab.
const searchIndex = normalizeSearch(
  [
    sermon.title,
    sermon.preacher,
    sermon.series,
    formatPassages(sermon.passages),
    sermon.passages.map((p) => p.book).join(' '),
    sermon.description,
  ]
    .filter(Boolean)
    .join(' '),
);

// Pipe-umschlossen, damit `includes('|roemer|')` exakt trifft statt in
// einem längeren Buchschlüssel mitzulesen (z.B. "roemer" in einem
// hypothetischen "1-roemer").
const bookKeys = `|${[...new Set(sermon.passages.map((p) => p.book))].join('|')}|`;
const preacherKey = sermon.preacher.trim().toLowerCase();
const seriesKey = sermon.series?.trim().toLowerCase() ?? '';

// Farbrotation als data-Attribut statt Inline-Style: SermonFilter.astro
// weist sichtbaren Kacheln beim Filtern neue Werte zu, damit die
// Dreierfolge nach Positionen in der sichtbaren Auswahl läuft statt nach
// der ursprünglichen Listenposition (siehe dortiges Skript). Die
// eigentlichen Token bleiben ausschließlich in den Styles unten.
//
// view-transition-name identifiziert die Kachel über einen Filterwechsel
// hinweg als dasselbe Element (siehe SermonFilter.astro) — der Browser
// gleitet sie dadurch in ihre neue Rasterposition statt zu springen. Der
// Slug taugt als Identifier, siehe overlayId oben; "sermon-"-Präfix
// garantiert einen gültigen CSS-Identifier auch bei ziffernstartendem
// Slug. Auf der Startseite (Slider) ist der Name inert, da dort keine
// Transition ausgelöst wird.
---

<div class="card-wrap" data-sermon data-surface={index % 3} data-search={searchIndex}
     data-books={bookKeys} data-preacher={preacherKey} data-series={seriesKey}
     style={`view-transition-name: sermon-${sermon.slug}`}>
  <a href={permalink} class="card">
    <span class="passage">{formatPassages(sermon.passages)}</span>
    <p class="title">{sermon.title}</p>
    <p class="meta">
      {dateFormatter.format(new Date(sermon.date))} &middot;{' '}
      {sermon.preacher}
    </p>
    <span class="chevron" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
           stroke-linecap="round" stroke-linejoin="round">
        <path d="M9 6l6 6-6 6" />
      </svg>
    </span>
  </a>
  <button
    type="button"
    popovertarget={overlayId}
    class="open"
    tabindex="-1"
    aria-label={`Predigt öffnen: ${sermon.title}`}
  >
  </button>
</div>

<Overlay id={overlayId} label={sermon.title}>
  <h2 class="overlay-title">{sermon.title}</h2>
  <SermonDetail sermon={sermon} profile={preacherProfile} permalink={permalink} />
</Overlay>

<style>
  .card-wrap {
    position: relative;
  }

  /* Dreierfolge der Kachelflächen, per data-Attribut statt Inline-Style
     (siehe Skript-Kommentar oben) — so kann SermonFilter.astro beim
     Filtern die Reihenfolge unter den sichtbaren Kacheln neu vergeben,
     ohne Tokens im JavaScript zu kennen. */
  .card-wrap[data-surface='0'] {
    --card-surface: var(--surface-warm);
    --card-surface-hover: var(--surface-warm-strong);
  }

  .card-wrap[data-surface='1'] {
    --card-surface: var(--surface-warm-alt);
    --card-surface-hover: var(--surface-warm-alt-strong);
  }

  .card-wrap[data-surface='2'] {
    --card-surface: var(--surface-nature);
    --card-surface-hover: var(--surface-nature-strong);
  }

  .card {
    position: relative;
    display: block;
    text-decoration: none;
    color: var(--text-primary);
    padding: var(--sp-4) var(--sp-3) var(--sp-5);
    border-radius: var(--radius-md) var(--radius-lg) var(--radius-md) var(--radius-md);
    background-color: var(--card-surface);
    transition:
      translate var(--duration-fast) var(--ease-out),
      background-color var(--duration-fast) var(--ease-out);
  }

  /* .open liegt im Stapel über .card und fängt den Zeiger zuerst ab —
     card:hover würde nie feuern. Fokus kommt weiterhin über den Anker
     selbst (Tab-Reihenfolge, siehe oben), dafür reicht die globale
     :focus-visible-Regel in global.css. */
  .card-wrap:has(.open:hover) .card,
  .card:focus-visible {
    background-color: var(--card-surface-hover);
    translate: 0 -2px;
  }

  .card-wrap:has(.open:hover) .title,
  .card:focus-visible .title {
    text-decoration: underline;
  }

  /* Dauerhaft sichtbar (nicht erst bei Hover) — auf Touch gibt es keinen
     Hover, ohne dieses Icon wäre die Klickbarkeit dort unsichtbar. */
  .chevron {
    position: absolute;
    right: var(--sp-3);
    bottom: var(--sp-3);
    width: 1em;
    color: var(--text-secondary);
    transition: translate var(--duration-fast) var(--ease-out);
  }

  .card-wrap:has(.open:hover) .chevron,
  .card:focus-visible .chevron {
    translate: 2px 0;
  }

  .card:visited {
    color: var(--text-primary);
  }

  .passage {
    display: block;
    margin-bottom: var(--sp-2);
    font-family: var(--font-display);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: var(--tracking-display);
    font-size: var(--fs-xs);
    color: var(--text-primary);
  }

  /* font-weight bleibt bei 400 (Normal) — es ist nur ein Schnitt von
     Source Serif Pro geladen; "bold" würde der Browser synthetisch
     nachzeichnen. Abhebung kommt über Größe, nicht Gewicht. */
  .title {
    font-size: var(--fs-m);
    line-height: var(--lh-tight);
    margin: 0;
  }

  .meta {
    color: var(--text-secondary);
    font-size: var(--fs-xs);
    margin: var(--sp-1) 0 0;
  }

  /* Der Button liegt deckungsgleich über der Kachel und fängt den
     Maus-/Touch-Klick zuerst ab — Öffnen des Popups ist damit die primäre
     Zeigegeräte-Aktion. tabindex="-1" (im Markup) nimmt ihn aus der
     Tab-Reihenfolge, sonst gäbe es zwei Tab-Stopps pro Kachel.
     Ohne Popover-Unterstützung wird der Button ausgeblendet und der
     Klick fällt durch auf den Anker darunter, der ganz normal zur
     Detailseite führt. */
  .open {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    padding: 0;
    margin: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
  }

  @supports not selector(:popover-open) {
    .open {
      display: none;
    }
  }

  .overlay-title {
    margin: 0;
  }
</style>
