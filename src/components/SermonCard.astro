---
import type { Sermon } from '../lib/sanity';
import type { CollectionEntry } from 'astro:content';
import { formatPassages } from '../lib/bible';
import { normalizeSearch } from '../lib/search';
import Overlay from './Overlay.astro';
import SermonDetail from './SermonDetail.astro';

// Kachel für eine Predigt, genutzt auf der Startseite und der
// Predigtübersicht. Ohne Foto (siehe CLAUDE.md — keine Stock-Fotografie,
// echte Gemeindefotos gibt es noch nicht): die ganze Kachelfläche trägt
// eine stark verdünnte Akzentfarbe (siehe tokens.css, --surface-warm),
// die Bibelstelle steht als Eyebrow über dem Titel.
//
// Ein Klick öffnet den Inhalt als Popup (siehe Overlay.astro) statt einer
// neuen Seite. Die Kachel bleibt zusätzlich ein echter Link zur
// Detailseite (predigten/[slug].astro) — das hält den Permalink crawlbar
// und ist der Rückfall für Browser ohne Popover-Unterstützung (siehe
// @supports-Block unten).
//
// Zwei übereinanderliegende Elemente: der Anker (normal fokussierbar,
// Tastatur-Weg zur Detailseite) und der deckungsgleiche Button
// (tabindex="-1", nur per Maus/Touch erreichbar, öffnet das Popup). Ein
// Element könnte nicht beides — <a popovertarget> wird vom Browser
// ignoriert, das Attribut funktioniert nur auf <button>.
//
// preacherProfile: gesetzt, wenn ein passendes Repo-Profil existiert
// (siehe predigten/index.astro für die Verknüpfungslogik).
interface Props {
  sermon: Sermon;
  preacherProfile?: CollectionEntry<'elders'>;
  // Listenindex, nur für die Wahl der Farbwolke (siehe MinistryCard).
  index?: number;
}

const { sermon, preacherProfile, index = 0 } = Astro.props;

const dateFormatter = new Intl.DateTimeFormat('de-DE', { dateStyle: 'long' });
const overlayId = `sermon-${sermon.slug}`;
const permalink = `/predigten/${sermon.slug}`;

// Filterdaten für SermonFilter.astro (siehe dort). Auf Seiten ohne Filter
// (Startseite, Slider) bleiben diese Attribute schlicht ungenutzt.
//
// searchIndex deckt Titel, Prediger, Reihe, Bibelstelle (deutsch und als
// ASCII-Buchschlüssel, siehe bible.ts) und Beschreibung ab.
const searchIndex = normalizeSearch(
  [
    sermon.title,
    sermon.preacher,
    sermon.series,
    formatPassages(sermon.passages),
    sermon.passages.map((p) => p.book).join(' '),
    sermon.description,
  ]
    .filter(Boolean)
    .join(' '),
);

// Pipe-umschlossen, damit `includes('|roemer|')` exakt trifft statt in
// einem längeren Buchschlüssel mitzulesen (z.B. "roemer" in einem
// hypothetischen "1-roemer").
const bookKeys = `|${[...new Set(sermon.passages.map((p) => p.book))].join('|')}|`;
const preacherKey = sermon.preacher.trim().toLowerCase();
const seriesKey = sermon.series?.trim().toLowerCase() ?? '';

// view-transition-name identifiziert die Kachel über einen Filterwechsel
// hinweg als dasselbe Element (siehe SermonFilter.astro) — der Browser
// gleitet sie dadurch in ihre neue Rasterposition statt zu springen. Der
// Slug taugt als Identifier, siehe overlayId oben; "sermon-"-Präfix
// garantiert einen gültigen CSS-Identifier auch bei ziffernstartendem
// Slug. Auf der Startseite (Slider) ist der Name inert, da dort keine
// Transition ausgelöst wird.
---

<div class="card-wrap" data-sermon data-search={searchIndex}
     data-books={bookKeys} data-preacher={preacherKey} data-series={seriesKey}
     style={`view-transition-name: sermon-${sermon.slug}; --cloud: var(--cloud-${(index % 4) + 1}); --reveal-offset: ${(index % 3) * 4}%`}
     data-reveal>
  <a href={permalink} class="card">
    <span class="cloud" aria-hidden="true"></span>
    <span class="body">
      <span class="top">
        <span class="passage">{formatPassages(sermon.passages)}</span>
        <span class="plus" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <path d="M12 5v14M5 12h14" />
          </svg>
        </span>
      </span>
      <span class="text">
        <span class="title">{sermon.title}</span>
        <span class="meta">
          {dateFormatter.format(new Date(sermon.date))} &middot; {sermon.preacher}
        </span>
      </span>
    </span>
  </a>
  <button
    type="button"
    popovertarget={overlayId}
    class="open"
    tabindex="-1"
    aria-label={`Predigt öffnen: ${sermon.title}`}
  >
  </button>
</div>

<Overlay id={overlayId} label={sermon.title} cloud={(index % 4) + 1}>
  <Fragment slot="head">
    <span class="kicker">{formatPassages(sermon.passages)}</span>
    <h2>{sermon.title}</h2>
  </Fragment>
  <SermonDetail sermon={sermon} profile={preacherProfile} permalink={permalink} showPassages={false} />
</Overlay>

<style>
  .card-wrap {
    position: relative;
  }

  /* Gleiches Kachelmuster wie MinistryCard.astro — dort steht die
     ausführliche Begründung. Bewusst dupliziert statt in eine gemeinsame
     Komponente gezogen (CLAUDE.md Regel 2): Die vier Kacheltypen
     unterscheiden sich in Aufbau (Anker + Button vs. einzelner Button),
     Inhalt und Seitenverhältnis genug, dass eine Abstraktion mehr
     Bedingungen bräuchte, als sie Code spart. */
  .card {
    position: relative;
    display: block;
    aspect-ratio: 4 / 5;
    border-radius: var(--radius-lg);
    overflow: clip;
    background-color: var(--bg-inverted);
    color: var(--text-on-dark);
    box-shadow: var(--shadow-card);
    text-decoration: none;
    transition:
      translate var(--duration-slow) var(--ease-out),
      box-shadow var(--duration-slow) var(--ease-out);
  }

  .card:visited {
    color: var(--text-on-dark);
  }

  /* .open liegt im Stapel über .card und fängt den Zeiger zuerst ab —
     card:hover würde nie feuern. Fokus kommt weiterhin über den Anker
     selbst (Tab-Reihenfolge, siehe oben). */
  .card-wrap:has(.open:hover) .card,
  .card:focus-visible {
    translate: 0 -8px;
    box-shadow: var(--shadow-card-hover);
  }

  .cloud {
    position: absolute;
    inset: -12%;
    background-image: var(--cloud);
    transition: scale var(--duration-slow) var(--ease-out);
  }

  /* Die Farbwolke wandert sehr langsam, damit die Kachel eine Fläche mit
     Leben ist und kein Standbild. Bewegt wird `translate` (nicht
     `background-position`): Das läuft auf dem Compositor und kostet keine
     Neuzeichnung pro Bild — bei acht Kacheln auf einem Telefon der
     Unterschied zwischen flüssig und ruckelig. Deshalb ist die Wolke auch
     größer als die Kachel (inset: -12%), sonst liefe beim Wandern eine
     Kante ins Bild.

     `scale` bleibt dabei frei für den Hover-Zustand — Animation und
     Transition fassen verschiedene Eigenschaften an und geraten sich
     nicht in die Quere. */
  @media (prefers-reduced-motion: no-preference) {
    .cloud {
      animation: cloud-drift 26s var(--ease-out) infinite alternate;
    }

    @keyframes cloud-drift {
      from {
        translate: -3% -2%;
      }
      to {
        translate: 3% 2%;
      }
    }
  }


  .card-wrap:has(.open:hover) .cloud,
  .card:focus-visible .cloud {
    scale: 1.06;
  }

  .body {
    position: absolute;
    inset: 0;
    display: grid;
    /* minmax(0, 1fr) statt der impliziten Spalte: Grid-Items haben
       min-width: auto und wachsen sonst über die Kachel hinaus, sobald ein
       langes Wort wie „Sonntagsgottesdienste" nicht in die Zeile passt —
       overflow-wrap greift dann nie, weil es gar keine zu enge Zeile gibt.
       Sichtbar wurde das als abgeschnittener Titel und verschobenem
       Plus-Kreis. */
    grid-template-columns: minmax(0, 1fr);
    align-content: space-between;
    gap: var(--sp-3);
    padding: var(--sp-4);
    background-image: var(--scrim-card);
  }

  .top {
    min-width: 0;
    display: flex;
    align-items: start;
    justify-content: space-between;
    gap: var(--sp-3);
  }

  .passage,
  .plus {
    background-color: color-mix(in srgb, var(--text-on-dark) 14%, transparent);
    border: 1px solid color-mix(in srgb, var(--text-on-dark) 28%, transparent);
    border-radius: var(--radius-pill);
    -webkit-backdrop-filter: blur(var(--blur-glass));
    backdrop-filter: blur(var(--blur-glass));
  }

  .passage {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--fs-xs);
    letter-spacing: var(--tracking-label);
    line-height: 1;
    text-transform: uppercase;
    padding: var(--sp-2) var(--sp-3);
  }

  .plus {
    flex-shrink: 0;
    margin-left: auto;
    display: grid;
    place-items: center;
    width: 2.375rem;
    height: 2.375rem;
    transition: rotate var(--duration-slow) var(--ease-out);
  }

  .plus svg {
    width: 1.1rem;
    height: 1.1rem;
  }

  .card-wrap:has(.open:hover) .plus,
  .card:focus-visible .plus {
    rotate: 90deg;
  }

  /* Der Textblock rückt beim Überfahren ein Stück nach oben — dieselbe
     Richtung wie die Kachel selbst, nur weiter, sodass die Bewegung Tiefe
     bekommt statt nur zu verschieben. */
  .card-wrap:has(.open:hover) .text,
  .card:focus-visible .text {
    translate: 0 -4px;
  }

  /* Auch hier minmax(0, 1fr) statt der impliziten Spalte, aus demselben
     Grund wie bei .body: overflow-wrap: break-word verkleinert die
     min-content-Breite NICHT, ein Grid-Item mit min-width: auto bleibt
     also so breit wie sein längstes Wort und sprengt die Kachel. Erst die
     Nullspur zwingt die Zeile auf die Kachelbreite, dann greift der
     Umbruch. */
  .text {
    min-width: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--sp-2);
    transition: translate var(--duration-slow) var(--ease-out);
  }

  .title {
    display: block;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--fs-l);
    line-height: var(--lh-tight);
    letter-spacing: var(--tracking-tight);
    -webkit-hyphens: auto;
    hyphens: auto;
    overflow-wrap: break-word;
  }

  .meta {
    font-size: var(--fs-xs);
    color: color-mix(in srgb, var(--text-on-dark) 78%, transparent);
  }

  /* Der Button liegt deckungsgleich über der Kachel und fängt den
     Maus-/Touch-Klick zuerst ab — Öffnen des Popups ist damit die primäre
     Zeigegeräte-Aktion. tabindex="-1" (im Markup) nimmt ihn aus der
     Tab-Reihenfolge. Ohne Popover-Unterstützung wird er ausgeblendet und
     der Klick fällt durch auf den Anker darunter. */
  .open {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    padding: 0;
    margin: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
  }

  @supports not selector(:popover-open) {
    .open {
      display: none;
    }
  }

</style>
