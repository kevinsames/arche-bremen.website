---
// Popup-Hülle für Predigt- und Ältesten-Kacheln (siehe SermonCard,
// ElderCard). Baut auf der HTML-Popover-API auf (popover="auto"),
// nicht auf JavaScript — Öffnen/Schließen per Klick, Escape und Klick
// daneben erledigt der Browser. Damit bleibt die Seite bei 0 KB
// Client-JS (siehe CLAUDE.md Regel 4).
//
// Unterstützt der Browser die Popover-API nicht (z.B. ältere iOS-Versionen),
// bleibt dieses Element schlicht ungeöffnet liegen — der auslösende Anker
// in SermonCard/ElderCard führt dann stattdessen direkt zur Detailseite
// (siehe dortiger @supports-Block).
interface Props {
  id: string;
  label: string;
}

const { id, label } = Astro.props;
---

<div id={id} popover="auto" aria-label={label} class="overlay">
  <button type="button" popovertarget={id} popovertargetaction="hide" class="close" aria-label="Schließen">
    &times;
  </button>
  <div class="content">
    <slot />
  </div>
</div>

<style>
  /* border/padding auf 0 zurückgesetzt — der Browser gibt [popover]
     sonst eine UA-Rahmen/Abstand-Vorgabe mit, die die Tokens überschreiben
     müssten. */
  .overlay {
    border: 0;
    padding: 0;
    margin: auto;
    background-color: var(--bg-page);
    color: var(--text-primary);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-overlay);
    width: min(100% - 2 * var(--sp-3), var(--measure));
    max-height: 85dvh;
    overflow-y: auto;

    opacity: 0;
    translate: 0 var(--sp-2);
    transition:
      opacity var(--duration-fast) var(--ease-out),
      translate var(--duration-fast) var(--ease-out),
      overlay var(--duration-fast) var(--ease-out) allow-discrete,
      display var(--duration-fast) var(--ease-out) allow-discrete;
  }

  .overlay:popover-open {
    opacity: 1;
    translate: 0 0;
  }

  @starting-style {
    .overlay:popover-open {
      opacity: 0;
      translate: 0 var(--sp-2);
    }
  }

  .overlay::backdrop {
    background-color: var(--scrim);
    -webkit-backdrop-filter: blur(var(--blur-overlay));
    backdrop-filter: blur(var(--blur-overlay));
  }

  /* Mobil als von unten angedockte Sheet — die auf Telefonen erwartete
     Geste für Popups, statt einer schwebenden Karte in der Bildschirmmitte. */
  @media (max-width: 40rem) {
    .overlay {
      position: fixed;
      inset: auto 0 0 0;
      width: 100%;
      max-height: 80dvh;
      border-radius: var(--radius-xl) var(--radius-xl) 0 0;
      translate: 0 100%;
    }

    .overlay:popover-open {
      translate: 0 0;
    }

    @starting-style {
      .overlay:popover-open {
        translate: 0 100%;
      }
    }
  }

  /* Runder Schließen-Knopf, gleiche Geometrie wie die Icon-Knöpfe der
     Kachelreihe und des Menü-Sheets (.icon-button in global.css) — hier
     als eigene Regel, weil der Knopf zusätzlich sticky mitscrollt. */
  .close {
    position: sticky;
    top: var(--sp-3);
    float: right;
    margin: var(--sp-3);
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    line-height: 1;
    border: 1px solid color-mix(in srgb, var(--text-primary) 25%, transparent);
    border-radius: var(--radius-pill);
    background-color: var(--bg-page);
    color: var(--text-primary);
    font-size: var(--fs-m);
    cursor: pointer;
    transition:
      background-color var(--duration-fast) var(--ease-out),
      color var(--duration-fast) var(--ease-out),
      border-color var(--duration-fast) var(--ease-out);
  }

  .close:hover,
  .close:focus-visible {
    background-color: var(--bg-inverted);
    border-color: var(--bg-inverted);
    color: var(--text-on-dark);
  }

  .content {
    padding: clamp(var(--sp-4), 4vw, var(--sp-5));
    clear: both;
  }

  /* Überschriften im Popup eine Stufe kleiner als im Seitenfluss: Die
     globale h2-Größe (--fs-xxl, bis 4.5rem) ist für ein Schauband auf
     voller Seitenbreite gedacht und sprengt eine Karte von --measure
     Breite — „Sonntagsgottesdienste" stand darin über vier Zeilen. Gilt
     für alles, was über den Slot hereinkommt, deshalb :global. */
  .content :global(h2) {
    font-size: var(--fs-xl);
  }

  .content :global(h3) {
    font-size: var(--fs-l);
  }
</style>
