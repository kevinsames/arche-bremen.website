---
import { render, type CollectionEntry } from 'astro:content';
import Overlay from './Overlay.astro';

// Kachel für ein Prediger-Profil auf /prediger, gleiche Bauweise wie
// SermonCard: Anker (Tastatur-Weg zur Detailseite) und deckungsgleicher
// Button (Maus/Touch, öffnet das Popup mit dem gerenderten Markdown-Body).
// Details siehe Kommentar in SermonCard.astro.
interface Props {
  preacher: CollectionEntry<'preachers'>;
}

const { preacher } = Astro.props;
const { Content } = await render(preacher);
const overlayId = `preacher-${preacher.id}`;
const permalink = `/prediger/${preacher.id}`;
---

<div class="card-wrap">
  <a href={permalink} class="card">
    <p class="name">{preacher.data.name}</p>
    {preacher.data.role && <p class="role">{preacher.data.role}</p>}
  </a>
  <button
    type="button"
    popovertarget={overlayId}
    class="open"
    tabindex="-1"
    aria-label={`Prediger öffnen: ${preacher.data.name}`}
  >
  </button>
</div>

<Overlay id={overlayId} label={preacher.data.name}>
  <h2 class="overlay-name">{preacher.data.name}</h2>
  {preacher.data.role && <p class="overlay-role">{preacher.data.role}</p>}
  <div class="prose">
    <Content />
  </div>
  <p><a href={permalink}>Zum Profil &rarr;</a></p>
</Overlay>

<style>
  .card-wrap {
    position: relative;
  }

  .card {
    display: block;
    text-decoration: none;
    color: var(--text-primary);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: var(--sp-3);
    background-color: var(--bg-page);
    transition:
      transform var(--duration-fast) var(--ease-out),
      border-color var(--duration-fast) var(--ease-out);
  }

  .card-wrap:has(.open:hover) .card {
    border-color: var(--c-blue);
    transform: scale(1.02);
  }

  .card:focus-visible {
    border-color: var(--c-blue);
    transform: scale(1.02);
  }

  .card:visited {
    color: var(--text-primary);
  }

  .name {
    font-family: var(--font-display);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: var(--tracking-display);
    font-size: var(--fs-m);
    margin: 0;
  }

  .role {
    color: var(--text-secondary);
    font-size: var(--fs-xs);
    margin: var(--sp-1) 0 0;
  }

  .open {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    padding: 0;
    margin: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
  }

  @supports not selector(:popover-open) {
    .open {
      display: none;
    }
  }

  .overlay-name {
    margin: 0;
  }

  .overlay-role {
    color: var(--text-secondary);
    margin: var(--sp-1) 0 0;
  }
</style>
