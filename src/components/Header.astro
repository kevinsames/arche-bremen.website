---
import { Image } from 'astro:assets';
import { SITE } from '../consts';
import logoLockup from '../assets/brand/logo-lockup-blue.jpg';

const navItems = [
  { href: '/', label: 'Start' },
  { href: '/predigten', label: 'Predigten' },
  { href: '/prediger', label: 'Prediger' },
  { href: '/glaubensbekenntnis', label: 'Glaubensbekenntnis' },
];

const currentPath = Astro.url.pathname;
---

<header>
  <div class="bar">
    <a href="/" class="site-name">
      <Image src={logoLockup} alt={SITE.name} width={216} densities={[1, 2]} format="webp" quality={90} />
    </a>
    <nav>
      <ul>
        {
          navItems.map((item) => (
            <li>
              <a href={item.href} aria-current={currentPath === item.href ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <a class="button donate" href="https://www.arche-gemeinde.de/spenden" target="_blank" rel="noopener">
      <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
        <path d="M12 21s-7.5-4.6-10-9.2C.5 8.2 2 4.5 5.5 4c2-.3 3.8.7 6.5 3 2.7-2.3 4.5-3.3 6.5-3C22 4.5 23.5 8.2 22 11.8 19.5 16.4 12 21 12 21Z" />
      </svg>
      Spenden
    </a>
  </div>
</header>

<style>
  header {
    position: sticky;
    top: 0;
    z-index: 10;
    border-bottom: 1px solid var(--border-subtle);
    background-color: var(--bg-page);
  }

  /* Leicht transluzent mit Weichzeichner, wo unterstützt. Ohne Support
     bleibt es die deckende Fläche oben — kein Fehlerfall. */
  @supports (backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px)) {
    header {
      background-color: color-mix(in srgb, var(--bg-page) 85%, transparent);
      -webkit-backdrop-filter: blur(12px);
      backdrop-filter: blur(12px);
    }
  }

  .bar {
    max-width: var(--width-content);
    margin-inline: auto;
    padding: var(--sp-2) var(--sp-3);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-2);
  }

  .site-name {
    display: inline-flex;
    line-height: 0;
  }

  /* Interim-Logo ist ein JPEG ohne Alphakanal (siehe DESIGN.md, Abschnitt
     Logo) — der weiße Hintergrund würde als deckender Kasten über der
     transluzenten Kopfzeile liegen. mix-blend-mode macht Weiß transparent
     und lässt nur die dunkelblauen Konturen stehen. Funktioniert nur auf
     hellem Grund; entfällt, sobald die offizielle SVG mit Alphakanal da ist. */
  .site-name :global(img) {
    width: var(--size-logo-header);
    height: auto;
    mix-blend-mode: multiply;
  }

  nav ul {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-3);
    margin: 0;
    padding: 0;
  }

  nav a {
    text-decoration: none;
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-display);
    padding-bottom: var(--sp-1);
    border-bottom: 2px solid transparent;
    transition: border-color var(--duration-fast) var(--ease-out);
  }

  nav a:hover {
    border-color: var(--border-subtle);
  }

  nav a[aria-current='page'] {
    border-color: var(--accent-warm);
  }

  /* Kompaktere Variante der globalen .button-Klasse (global.css) — hier
     im Header genügt weniger Fläche als bei einem Call-to-Action im
     Seiteninhalt. */
  .donate {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-1);
    padding: var(--sp-1) var(--sp-3);
    font-size: var(--fs-xs);
  }

  .donate .icon {
    width: 1em;
    height: 1em;
  }
</style>
