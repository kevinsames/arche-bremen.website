---
import { SITE } from '../consts';

const navItems = [
  { href: '/', label: 'Start' },
  { href: '/predigten', label: 'Predigten' },
  { href: '/prediger', label: 'Prediger' },
  { href: '/glaubensbekenntnis', label: 'Glaubensbekenntnis' },
];

const currentPath = Astro.url.pathname;
---

<header>
  <div class="bar">
    <a href="/" class="site-name">{SITE.name}</a>
    <nav>
      <ul>
        {
          navItems.map((item) => (
            <li>
              <a href={item.href} aria-current={currentPath === item.href ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  header {
    position: sticky;
    top: 0;
    z-index: 10;
    border-bottom: 1px solid var(--border-subtle);
    background-color: var(--bg-page);
  }

  /* Leicht transluzent mit Weichzeichner, wo unterstützt. Ohne Support
     bleibt es die deckende Fläche oben — kein Fehlerfall. */
  @supports (backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px)) {
    header {
      background-color: color-mix(in srgb, var(--bg-page) 85%, transparent);
      -webkit-backdrop-filter: blur(12px);
      backdrop-filter: blur(12px);
    }
  }

  .bar {
    max-width: var(--width-content);
    margin-inline: auto;
    padding: var(--sp-2) var(--sp-3);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-2);
  }

  .site-name {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: var(--fs-m);
    text-transform: uppercase;
    letter-spacing: var(--tracking-display);
    text-decoration: none;
    color: var(--text-primary);
  }

  nav ul {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-3);
    margin: 0;
    padding: 0;
  }

  nav a {
    text-decoration: none;
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-display);
    padding-bottom: var(--sp-1);
    border-bottom: 2px solid transparent;
    transition: border-color var(--duration-fast) var(--ease-out);
  }

  nav a:hover {
    border-color: var(--border-subtle);
  }

  nav a[aria-current='page'] {
    border-color: var(--accent-warm);
  }
</style>
