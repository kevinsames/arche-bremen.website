---
import { SITE } from '../consts';
import logo from '../assets/brand/arche-logo.svg';
import Overlay from './Overlay.astro';

const navItems = [
  { href: '/', label: 'Start' },
  { href: '/predigten', label: 'Predigten' },
  { href: '/gemeindeleben', label: 'Gemeindeleben' },
  { href: '/gemeindeleitung', label: 'Gemeindeleitung' },
  { href: '/glaubensbekenntnis', label: 'Glaubensbekenntnis' },
];

// Gleiche Normalisierung wie in BaseLayout.astro: Astro.url.pathname endet
// bei build.format 'directory' auf '/', die hrefs oben aber nicht — ohne
// diese Zeile bekommt keine Unterseite aria-current="page".
const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
---

<header>
  <div class="bar">
    <a href="/" class="site-name">
      <img src={logo.src} width={logo.width} height={logo.height} alt={SITE.name} />
    </a>

    <!-- Sichtbar unter 64rem (siehe @media-Block unten): öffnet das Sheet
         mit der Navigation als Popup. Ab 64rem ausgeblendet, dann steht
         .nav-inline an derselben Stelle. -->
    <button type="button" popovertarget="site-menu" class="menu-toggle" aria-label="Menü">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" focusable="false">
        <path d="M3 6h18" />
        <path d="M3 12h18" />
        <path d="M3 18h18" />
      </svg>
    </button>

    <!-- Ab 64rem sichtbare Navigation in der Kopfzeile. Dieselben navItems
         wie im Sheet unten (siehe Kommentar dort) — von den beiden ist
         durch die Media Queries immer nur eine im Baum sichtbar, nie
         beide gleichzeitig. -->
    <nav class="nav-inline" aria-label="Hauptnavigation">
      <ul>
        {
          navItems.map((item) => (
            <li>
              <a href={item.href} aria-current={currentPath === item.href ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <a class="button donate" href="https://www.arche-gemeinde.de/spenden" target="_blank" rel="noopener">
      <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
        <path d="M12 21s-7.5-4.6-10-9.2C.5 8.2 2 4.5 5.5 4c2-.3 3.8.7 6.5 3 2.7-2.3 4.5-3.3 6.5-3C22 4.5 23.5 8.2 22 11.8 19.5 16.4 12 21 12 21Z" />
      </svg>
      Spenden
    </a>
  </div>
</header>

<!-- Popup-Navigation für unter 64rem, exakt dieselben navItems wie oben in
     .nav-inline. Duplex statt gemeinsame Komponente (CLAUDE.md Regel 2) —
     die zwei Listen unterscheiden sich in Layout und Linkgröße genug, dass
     eine Abstraktion mehr Bedingungen bräuchte, als sie Code spart. -->
<Overlay id="site-menu" label="Menü">
  <nav class="nav-sheet" aria-label="Hauptnavigation">
    <ul>
      {
        navItems.map((item) => (
          <li>
            <a href={item.href} aria-current={currentPath === item.href ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</Overlay>

<style>
  header {
    position: sticky;
    top: 0;
    z-index: 10;
    border-bottom: 1px solid var(--border-subtle);
    background-color: var(--bg-page);
  }

  /* Leicht transluzent mit Weichzeichner, wo unterstützt. Ohne Support
     bleibt es die deckende Fläche oben — kein Fehlerfall. */
  @supports (backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px)) {
    header {
      background-color: color-mix(in srgb, var(--bg-page) 85%, transparent);
      -webkit-backdrop-filter: blur(12px);
      backdrop-filter: blur(12px);
    }
  }

  /* Bei jeder Breite eine Zeile mit drei Feldern: Logo, Mitte, Spenden.
     In der Mitte steht je nach Breite entweder der Burger-Knopf oder die
     Navigation — nie beide (siehe .menu-toggle/.nav-inline unten) — bei
     fünf Menüpunkten reicht die Breite unter 64rem (Grenze bereits an
     anderer Stelle im Repo verwendet, siehe glaubensbekenntnis.astro)
     sonst nicht für eine ungebrochene Navigationszeile. */
  .bar {
    max-width: var(--width-content);
    margin-inline: auto;
    padding: var(--sp-2) var(--sp-3);
    display: grid;
    grid-template-columns: auto auto auto;
    justify-content: space-between;
    align-items: center;
    column-gap: var(--sp-3);
  }

  .menu-toggle {
    justify-self: center;
    display: inline-flex;
    padding: var(--sp-1) var(--sp-2);
    margin: 0;
    border: 0;
    background: transparent;
    color: var(--text-primary);
    cursor: pointer;
  }

  .menu-toggle svg {
    width: 1.5em;
    height: 1.5em;
  }

  .nav-inline {
    display: none;
  }

  @media (min-width: 64rem) {
    .menu-toggle {
      display: none;
    }

    .nav-inline {
      display: block;
      justify-self: center;
    }
  }

  /* Browser ohne Popover-Unterstützung blenden [popover] in global.css
     dauerhaft aus (siehe dortiger Kommentar) — ohne diesen Block wäre die
     Navigation dort unter 64rem unerreichbar. Deshalb hier derselbe
     Zweizeiler, den der Header vor dem Burger-Menü hatte: die vollständige
     Navigation bricht bei Bedarf frei um, statt hinter einem Knopf zu
     verschwinden, der nichts öffnen kann.
     Alle drei Felder bekommen hier explizite grid-row/grid-column statt
     sich auf die Reihenfolge im Markup zu verlassen — im Markup steht
     .donate inzwischen NACH .nav-inline (wegen der Mitte-Position oben),
     die automatische Platzierung würde .donate sonst in eine eigene
     dritte Zeile schieben. */
  @supports not selector(:popover-open) {
    .bar {
      grid-template-columns: auto auto;
      row-gap: var(--sp-2);
    }

    .menu-toggle {
      display: none;
    }

    .site-name {
      grid-row: 1;
      grid-column: 1;
    }

    .donate {
      grid-row: 1;
      grid-column: 2;
    }

    .nav-inline {
      display: block;
      grid-row: 2;
      grid-column: 1 / -1;
    }

    .nav-inline ul {
      flex-wrap: wrap;
    }

    @media (min-width: 64rem) {
      .bar {
        grid-template-columns: auto auto auto;
      }

      .site-name {
        grid-row: 1;
        grid-column: 1;
      }

      .nav-inline {
        grid-row: 1;
        grid-column: 2;
      }

      .donate {
        grid-row: 1;
        grid-column: 3;
      }
    }
  }

  .site-name {
    display: inline-flex;
    line-height: 0;
    /* Grid-Items sind standardmäßig justify-self: stretch. Die Navigation
       spannt beide Spalten und ist oft breiter als Logo + Spenden-Knopf
       zusammen — ohne diese Zeile würden beide Spalten dadurch aufgeblasen
       und Logo/Button auf die volle Spaltenbreite gedehnt. */
    justify-self: start;
  }

  .site-name img {
    width: var(--size-logo-header);
    height: auto;
  }

  nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  nav a {
    display: inline-block;
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: var(--tracking-display);
    transition: border-color var(--duration-fast) var(--ease-out);
  }

  /* Navigation in der Kopfzeile (ab 64rem, siehe @media oben): horizontale
     Reihe, Aktiv-/Hover-Zustand als Unterstreichung — unverändert das
     bisherige Aussehen der Navigation vor dem Burger-Menü. */
  .nav-inline ul {
    display: flex;
    gap: var(--sp-3);
  }

  .nav-inline a {
    font-size: var(--fs-xs);
    padding-bottom: var(--sp-1);
    border-bottom: 2px solid transparent;
  }

  .nav-inline a:hover {
    border-color: var(--border-subtle);
  }

  .nav-inline a[aria-current='page'] {
    border-color: var(--accent-warm);
  }

  /* Navigation im Popup-Sheet (unter 64rem): senkrechte Liste, größere
     Schrift und Innenabstand für Trefferflächen von rund 44px auf Touch —
     kein neues Token, nur --fs-m statt --fs-xs (CLAUDE.md Design-Regel 7).
     Aktiv-/Hover-Zustand als linker Balken statt Unterstreichung, weil die
     Links hier die volle Breite einnehmen und untereinanderstehen. */
  .nav-sheet ul {
    display: grid;
    row-gap: var(--sp-1);
  }

  .nav-sheet a {
    font-size: var(--fs-m);
    padding: var(--sp-2) var(--sp-3);
    border-left: 2px solid transparent;
  }

  .nav-sheet a:hover {
    border-color: var(--border-subtle);
  }

  .nav-sheet a[aria-current='page'] {
    border-color: var(--accent-warm);
  }

  /* Kompaktere Variante der globalen .button-Klasse (global.css) — hier
     im Header genügt weniger Fläche als bei einem Call-to-Action im
     Seiteninhalt. Eigene Farbgebung statt der geerbten dunkelblauen
     Fläche: Gelb als Blickfang für den Spenden-Aufruf, ausschließlich als
     Fläche (siehe CLAUDE.md — Gelb nie als Textfarbe), Text bleibt in
     --text-primary für ausreichenden Kontrast auf Gelb. */
  .donate {
    display: inline-flex;
    align-items: center;
    /* Aus demselben Grund wie .site-name: nicht auf die Spaltenbreite
       dehnen, die die spannende Navigation vorgibt. */
    justify-self: end;
    gap: var(--sp-1);
    padding: var(--sp-1) var(--sp-3);
    font-size: var(--fs-xs);
    background-color: var(--accent-warm);
    border-color: var(--accent-warm);
    color: var(--text-primary);
  }

  .donate:visited {
    color: var(--text-primary);
  }

  .donate .icon {
    width: 1em;
    height: 1em;
  }
</style>
