---
import { SITE } from '../consts';
---

<header>
  <div class="bar">
    <a href="/" class="site-name">{SITE.name}</a>
    <nav>
      <ul>
        <li><a href="/">Start</a></li>
        <li><a href="/predigten">Predigten</a></li>
        <li><a href="/glaubensbekenntnis">Glaubensbekenntnis</a></li>
      </ul>
    </nav>
  </div>
</header>

<style>
  header {
    border-bottom: 1px solid var(--color-border);
  }

  .bar {
    max-width: var(--content-max-width);
    margin-inline: auto;
    padding: var(--space-sm) var(--space-md);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm);
  }

  .site-name {
    font-weight: bold;
    font-size: var(--font-size-lg);
    text-decoration: none;
    color: var(--color-text);
  }

  nav ul {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
    margin: 0;
    padding: 0;
  }

  nav a {
    text-decoration: none;
  }

  nav a:hover {
    text-decoration: underline;
  }
</style>
