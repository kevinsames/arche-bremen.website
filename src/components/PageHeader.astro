---
// Kopf einer Unterseite: dunkelblaues Band mit Farbwolke, darauf ein
// Versal-Kicker, die Überschrift und optional ein Einleitungssatz.
//
// Seit September 2026 der gemeinsame Auftakt aller Unterseiten. Vorher
// begann jede mit einer <h1> auf weißem Grund — nach dem Umbau von Hero,
// Kacheln und Popups war das der letzte Rest der alten Seite, und er ließ
// jede Unterseite unfertig aussehen. Dieselbe Bildsprache wie die Kacheln
// und der Kopf der Popups: Wer von einer Kachel auf eine Detailseite geht,
// bleibt in derselben Welt.
//
// Die Startseite hat ihren eigenen Hero (Ortsbild statt Farbwolke) und
// benutzt diese Komponente nicht.
interface Props {
  title: string;
  // Kleines Versal-Label über der Überschrift.
  eyebrow?: string;
  // Einleitungssatz unter der Überschrift.
  lead?: string;
  // Farbwolke 1–4 (siehe tokens.css). Ohne Angabe die erste.
  cloud?: number;
  // Rücksprung, z.B. von einer Detailseite zur Übersicht.
  back?: { href: string; label: string };
  // Bibelvers unter dem Einleitungssatz. Die Quellenzeile nennt bewusst
  // keine Übersetzung, nur „Die Bibel" (siehe DESIGN.md, „Bibelvers auf
  // dunklem Grund"). Welche zitiert wird, steht als Kommentar am Aufruf.
  verse?: { text: string; reference: string };
}

const { title, eyebrow, lead, cloud = 1, back, verse } = Astro.props;
---

<header class="page-head" style={`--cloud: var(--cloud-${((cloud - 1) % 4) + 1})`}>
  <span class="cloud" aria-hidden="true"></span>
  <div class="inner">
    {
      back && (
        <p class="back">
          <a href={back.href}>&larr; {back.label}</a>
        </p>
      )
    }
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1>{title}</h1>
    {lead && <p class="lead">{lead}</p>}
    {
      verse && (
        <figure class="verse">
          <blockquote>{verse.text}</blockquote>
          <figcaption>Die Bibel · {verse.reference}</figcaption>
        </figure>
      )
    }
  </div>
</header>

<style>
  .page-head {
    position: relative;
    isolation: isolate;
    /* Die Farbwolke ist größer als das Band (siehe .cloud) — ohne clip
       liefe sie in den Inhalt darunter. */
    overflow: clip;
    background-color: var(--bg-inverted);
    color: var(--text-on-dark);
  }

  /* Der Verlauf lag bis September 2026 als background-image am Band selbst.
     Das wirkte nicht: Ein Kind mit negativem z-index malt ÜBER den
     Hintergrund seines Elternelements, die Wolke lag also über dem
     Verlauf statt darunter, und die Schrift stand ungeschützt auf den
     hellen Stellen der Wolke. Gemessen wurde die gelbe Eyebrow dadurch mit
     5,45 : 1 statt der dokumentierten 8,38 : 1. Jetzt eine eigene Ebene
     zwischen Wolke (−2) und Schrift, auf Bandhöhe statt auf Wolkenhöhe. */
  .page-head::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image: var(--scrim-card);
  }

  .cloud {
    position: absolute;
    inset: -26%;
    z-index: -2;
    background-image: var(--cloud);
  }

  /* Wandert langsam wie auf den Kacheln (siehe MinistryCard.astro). */
  @media (prefers-reduced-motion: no-preference) {
    .cloud {
      animation: cloud-drift 14s var(--ease-in-out) infinite alternate;
    }

    @keyframes cloud-drift {
      from {
        translate: -6% -4%;
        rotate: -10deg;
      }
      to {
        translate: 6% 4%;
        rotate: 10deg;
      }
    }
  }

  /* Gleiche Breite und gleicher linker Anschlag wie Section.astro. */
  .inner {
    max-width: var(--width-content);
    margin-inline: auto;
    padding: clamp(var(--sp-6), 8vw, var(--sp-7)) var(--sp-3);
  }

  .back {
    margin: 0 0 var(--sp-4);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--fs-xs);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  .back a {
    color: inherit;
    text-decoration: none;
    padding-bottom: var(--sp-1);
    border-bottom: 2px solid transparent;
    transition: border-color var(--duration-fast) var(--ease-out);
  }

  .back a:visited {
    color: inherit;
  }

  .back a:hover,
  .back a:focus-visible {
    border-color: var(--accent-warm);
  }

  .eyebrow {
    color: var(--text-accent-on-dark);
  }

  h1 {
    margin: 0;
  }

  /* Die globale .lead-Stufe setzt --text-secondary (Braun) — auf dunklem
     Grund unlesbar. Hier eine leicht gedämpfte Variante von Weiß. */
  .lead {
    margin: var(--sp-4) 0 0;
    color: color-mix(in srgb, var(--text-on-dark) 82%, transparent);
  }

  /* Dasselbe Muster wie der Vers auf der Startseite (index.astro, siehe
     DESIGN.md „Bibelvers auf dunklem Grund"): gelbe Randlinie als Fläche,
     Quellenzeile in --text-accent-on-dark. Bewusst dupliziert statt als
     eigene Komponente — es sind zwei Stellen. */
  .verse {
    max-width: var(--measure);
    margin: var(--sp-5) 0 0;
    padding-left: var(--sp-3);
    border-left: 3px solid var(--accent-warm);
  }

  .verse blockquote {
    margin: 0;
    font-size: var(--fs-m);
    line-height: var(--lh-body);
    text-wrap: pretty;
  }

  /* Futura 500 statt 700: Kleiner als --fs-xs gibt die Skala nichts her,
     die Versangabe wird deshalb über den Schnitt zurückgenommen, damit sie
     neben dem Vers nicht zu stark ins Auge sticht (September 2026). */
  .verse figcaption {
    margin-top: var(--sp-2);
    font-family: var(--font-display);
    font-weight: 500;
    font-size: var(--fs-xs);
    letter-spacing: var(--tracking-label);
    line-height: var(--lh-tight);
    text-transform: uppercase;
    color: var(--text-accent-on-dark);
  }
</style>
